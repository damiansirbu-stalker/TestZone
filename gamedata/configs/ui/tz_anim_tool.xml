<w>
	<main x="0" y="0" width="1024" height="768"/>

	<!-- A compact band docked to the right edge. The rest of the screen stays transparent so the
	     aimed NPC is visible and you watch the motion play while you browse and verdict. -->
	<background x="790" y="16" width="226" height="620" stretch="1">
		<texture>ui_inGame2_pda_buttons_background</texture>
	</background>

	<hdr_player x="798" y="22" width="80" height="20">
		<text font="letterica18" align="l" r="200" g="170" b="120">ANIM</text>
	</hdr_player>
	<btn_reset x="846" y="20" width="76" height="24" stretch="1">
		<texture>ui_inGame2_pda_button</texture>
		<text font="letterica16" align="c" r="200" g="160" b="120">reset</text>
	</btn_reset>
	<btn_select x="928" y="20" width="80" height="24" stretch="1">
		<texture>ui_inGame2_pda_button</texture>
		<text font="letterica16" align="c" r="66" g="157" b="195">select</text>
	</btn_select>
	<line_player x="798" y="44" width="210" height="4" stretch="1">
		<texture>ui_inGame2_pda_line_horizontal</texture>
	</line_player>

	<screen x="798" y="52" width="210" height="42" stretch="1">
		<texture>ui_inGame2_pda_Filtr_plyer_interface_off</texture>
	</screen>
	<lbl_now x="802" y="54" width="202" height="18">
		<text font="letterica16" align="l" vert_align="c" r="66" g="157" b="195"/>
	</lbl_now>
	<lbl_mode x="802" y="74" width="202" height="18">
		<text font="letterica16" align="l" vert_align="c" r="66" g="157" b="195"/>
	</lbl_mode>

	<lbl_path x="798" y="98" width="210" height="18">
		<text font="letterica16" align="l" r="200" g="170" b="120"/>
	</lbl_path>
	<list_frame x="798" y="118" width="210" height="318">
		<texture>ui_inGame2_servers_list_frame</texture>
	</list_frame>
	<list x="801" y="121" width="204" height="312" item_height="20" can_select="1">
		<font font="letterica16"/>
	</list>

	<!-- transport: [ mode - ] [ mode + ]  [ prev ] [ play ] [ next ] [ stop ] -->
	<btn_pos_down x="798" y="442" width="32" height="26" stretch="1">
		<texture>ui_inGame2_pda_Filtr_radio_plyr_btn_v_down</texture>
	</btn_pos_down>
	<btn_pos_up x="832" y="442" width="32" height="26" stretch="1">
		<texture>ui_inGame2_pda_Filtr_radio_plyr_btn_v_up</texture>
	</btn_pos_up>
	<btn_prior x="872" y="442" width="32" height="26" stretch="1">
		<texture>ui_inGame2_pda_Filtr_radio_plyr_btn_prev</texture>
	</btn_prior>
	<btn_play x="906" y="442" width="32" height="26" stretch="1">
		<texture>ui_inGame2_pda_Filtr_radio_plyr_btn_start2</texture>
	</btn_play>
	<btn_next x="940" y="442" width="32" height="26" stretch="1">
		<texture>ui_inGame2_pda_Filtr_radio_plyr_btn_next</texture>
	</btn_next>
	<btn_stop x="974" y="442" width="32" height="26" stretch="1">
		<texture>ui_inGame2_pda_Filtr_radio_plyr_btn_stop2</texture>
	</btn_stop>

	<hdr_verdict x="798" y="476" width="210" height="16">
		<text font="letterica16" align="l" r="200" g="170" b="120">VERDICT</text>
	</hdr_verdict>
	<btn_good x="798" y="494" width="100" height="28" stretch="1">
		<texture>ui_inGame2_pda_button</texture>
		<text font="letterica16" align="c" r="120" g="200" b="120">good</text>
	</btn_good>
	<btn_bad x="904" y="494" width="104" height="28" stretch="1">
		<texture>ui_inGame2_pda_button</texture>
		<text font="letterica16" align="c" r="210" g="90" b="90">bad</text>
	</btn_bad>

	<hdr_snote x="798" y="532" width="210" height="16">
		<text font="letterica16" align="l" r="200" g="170" b="120">NOTE</text>
	</hdr_snote>
	<snote x="798" y="550" width="140" height="26" stretch="1">
		<text x="5" font="letterica16" vert_align="c" align="l"/>
		<texture>ui_inGame2_edit_box_2</texture>
	</snote>
	<btn_note x="944" y="550" width="62" height="26" stretch="1">
		<texture>ui_inGame2_pda_button</texture>
		<text font="letterica16" align="c">note</text>
	</btn_note>

	<status x="798" y="584" width="210" height="44">
		<text font="letterica16" align="l" complex_mode="1" r="160" g="160" b="160"/>
	</status>
</w>
