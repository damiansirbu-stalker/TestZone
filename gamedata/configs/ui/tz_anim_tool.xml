		<texture>ui_inGame2_edit_box_2</texture>
	</snote>
	<btn_note x="944" y="574" width="62" height="24" stretch="1">
		<texture>ui_inGame2_pda_button</texture>
		<text font="letterica16" align="c">note</text>
	</btn_note>

	<status x="798" y="612" width="210" height="36">
		<text font="letterica16" align="l" complex_mode="1" r="160" g="160" b="160"/>
	</status>
	<legend x="798" y="652" width="210" height="96">
		<text font="letterica16" align="l" complex_mode="1" r="170" g="160" b="130"/>
	</legend>
</w>
