--- tz_movie_tool: MovieTool - film mode, time scale, POV, chase, orbit and keyframed camera paths, lens and look. Opens on the MCM movie_key.

local string_format, math_pi, math_max, math_min, math_cos, math_sin = string.format, math.pi, math.max, math.min, math.cos, math.sin
local math_floor, math_atan2 = math.floor, math.atan2
local table_sort, tostring, pairs, os_date = table.sort, tostring, pairs, os.date
local IsStalker, IsMonster, time_continual = IsStalker, IsMonster, time_continual
local RegisterScriptCallback, UnregisterScriptCallback = RegisterScriptCallback, UnregisterScriptCallback

local log = xlog.get_logger("TestZone.movie", { outfile = "testzone_movie.log", level = "INFO" })

-- The prefix of this tool's file per game run in the logs folder (tz_ui.write_line).
local OUTPUT_TOOL = "movie_tool"
local CMD_GOD, CMD_HUD, CMD_FOV, CMD_NEAR = "g_god", "hud_draw", "fov", "viewport_near"
local CMD_TIME, CMD_FREEZE = "time_factor", "freeze_time"
local CMD_DOF, CMD_DOF_ON = "r2_dof", "r2_dof_enable"
-- The engine's depth of field default, near, focus and far (xray xrRender_console.cpp:501).
local DOF_DEFAULT = "-1.25,0,600"
local CMD_DEMO_START, CMD_DEMO_STOP = "demo_record movietool", "demo_record_stop"
-- The actor camera modes set_active_cam takes (xray actor_defs.h:20-22): first eye, look-at, free look.
local CAM_MODES = { 0, 1, 2 }
-- The camera modes a shot runs in; Free is the engine's demo_record and runs outside them.
local MODE_POV, MODE_CHASE, MODE_ORBIT, MODE_PATH = "pov", "chase", "orbit", "path"
-- The camera bone first, then the fallbacks a model without it may carry (GoPro_MOD, gopro_mod.script:88-100).
local CAMERA_BONES = { "bip01_head", "eye_left", "eye_right", "bip01_neck", "bip01_spine2", "bip01_spine1", "bip01_spine",
    "bip01_pelvis", "pelvis", "head", "head_boss" }
-- The head bones hidden while the camera sits in the head, so the target's own face never fills the shot.
local HEAD_BONES = { "bip01_head", "head", "head_boss" }
local IS_HEAD_CAMERA = { bip01_head = true, eye_left = true, eye_right = true, head = true, head_boss = true }
-- The engine's invalid id, for a bone the model lacks and for a squadless object's group.
local INVALID_ID = 65535
-- The engine camera smoothing: 1 is none; higher is calmer (xray EffectorBobbing.cpp:131-168). Paths play at none.
local CALM_START, CALM_STEP, CALM_MAX, CALM_NONE = 12, 4, 40, 1
local FORWARD_OFFSET, POV_NEAR = 0.03, 0.02
-- The player stays put until the target passes this share of the online radius, then rides FOLLOW_HEIGHT above it.
local FOLLOW_SHARE, FOLLOW_HEIGHT, FOLLOW_SLACK_SQR = 2 / 3, 10, 0.04
local DEATH_HOLD_MS = 5000
local FOV_START, FOV_STEP, FOV_MIN, FOV_MAX = 55, 5, 20, 120
-- The time scale ladder the slow and fast keys step through.
local TIME_STEPS = { 1, 0.5, 0.25, 0.1 }
-- Chase: metres behind and above the target, and how far ahead of it the camera looks.
local CHASE_BACK, CHASE_UP, CHASE_AHEAD = 4, 1.8, 3
-- Orbit: radius and height in metres, seconds per lap on real time.
local ORBIT_RADIUS, ORBIT_UP, ORBIT_LAP_S = 5, 1.6, 20
-- Where the camera aims on a target: this far above its position.
local AIM_UP = 1.2
-- Path: seconds per segment between two keys.
local PATH_SEGMENT_S = 3
-- Depth of field: how often the focus follows the target, and near and far as shares of the focus distance.
local DOF_PERIOD_MS, DOF_NEAR_SHARE, DOF_FAR_SHARE = 250, 0.5, 3
-- Filters from the effects TestZone's FX cycler plays (tz_fx.script), and their strength.
local FILTERS = { "flame.ppe", "radiation.ppe", "deimos.ppe", "brighten.ppe" }
local FILTER_SLOT, FILTER_FACTOR = 7710, 0.5
local SHAKE_ANM, SHAKE_ID = "camera_effects\\fatigue.anm", 7711
local WEATHERS = { "clear", "rain", "storm", "fog" }
local FEED_MAX, FEED_CHARS = 2, 30
-- Decor the window draws and never touches again.
local DECOR = { statics = { "hdr_tool", "scr_display_rim", "scr_display_glass", "scr_note_rim", "scr_note_glass",
    "note_plus_h", "note_plus_v", "scr_feed_rim", "scr_feed_glass", "cap_scene", "cap_camera", "cap_path", "cap_look" } }
local LABEL_RGB, LABEL_LIT_RGB = { 175, 180, 190 }, { 235, 240, 245 }
-- Every lit toggle: its key and its diode.
local TOGGLES = { "film", "freeze", "pov", "chase", "orbit", "freecam", "path", "loop", "look_at", "death", "dof", "filter", "shake", "bars",
    "cam_1", "cam_2", "cam_3" }

local _film = nil
local _mode = nil
local _shot = nil
local _target_id = nil
local _is_freecam = false
local _cam_mode = nil
local _is_death_cam = true
local _fov, _calm = FOV_START, CALM_START
local _time_i, _is_frozen = 1, false
local _keys = {}
local _is_loop, _is_look_at = false, false
local _dof = nil
local _filter_i = 0
local _is_shake = false
local _bars = nil
local _feed = {}
local _box = nil

local function _show_tip(text)
    xpda.show_tip(text, 4000)
end

local function _is_window_open()
    return _box ~= nil and _box:IsShown()
end

local function _render_window()
    if _is_window_open() then _box:render() end
end

-- Real milliseconds, which keep running under a slowed or frozen time scale.
local function _get_now()
    return time_continual()
end

-- A living stalker or mutant other than the player.
local function _is_filmable(obj)
    if not (obj and db.actor) or obj:id() == db.actor:id() then return false end
    return (IsStalker(obj) or IsMonster(obj)) and obj:alive()
end

local function _get_name(obj)
    if IsStalker(obj) then return obj:character_name() end
    return obj:section()
end

local function _get_target()
    return _target_id and xobject.get_go(_target_id)
end

-- The point a camera aims at on a target.
local function _get_aim_point(obj)
    local pos = vector():set(obj:position())
    pos.y = pos.y + AIM_UP
    return pos
end

-- Heading and pitch looking from pos to point, the horizon level.
local function _get_look_hpb(pos, point)
    local dir = vector():set(point):sub(pos)
    return vector():set(dir:getH(), dir:getP(), 0)
end

local function _find_bone(obj)
    for i = 1, #CAMERA_BONES do
        local id = obj:get_bone_id(CAMERA_BONES[i])
        if id ~= INVALID_ID then return CAMERA_BONES[i], id end
    end
    return nil, INVALID_ID
end

local function _find_head_bone(obj)
    for i = 1, #HEAD_BONES do
        if obj:get_bone_id(HEAD_BONES[i]) ~= INVALID_ID then return HEAD_BONES[i] end
    end
    return nil
end

--- While filming, every NPC that asks whether the player is an enemy gets no (xr_combat_ignore.script:84-87).
local function _apply_actor_veto(_, enemy, flags)
    if enemy and db.actor and enemy:id() == db.actor:id() then
        flags.override = true
        flags.result = false
    end
end

--- Film: the HUD and weapon hidden, god mode on, and no NPC takes the player as an enemy.
local function _start_film()
    if _film or not db.actor then return end
    local console = get_console()
    _film = { god = console:get_bool(CMD_GOD), hud = console:get_bool(CMD_HUD) }
    console:execute(CMD_GOD .. " on")
    console:execute(CMD_HUD .. " 0")
    show_all_ui(false)
    db.actor:hide_weapon()
    RegisterScriptCallback("on_enemy_eval", _apply_actor_veto)
    log.info("[FILM] on")
end

local function _stop_film()
    if not _film then return end
    UnregisterScriptCallback("on_enemy_eval", _apply_actor_veto)
    local console = get_console()
    console:execute(CMD_GOD .. (_film.god and " on" or " off"))
    console:execute(CMD_HUD .. (_film.hud and " 1" or " 0"))
    if db.actor then
        show_all_ui(true)
        db.actor:restore_weapon()
    end
    _film = nil
    log.info("[FILM] off")
end

--- Apply the time scale: frozen, or the ladder step; sound pitch follows the scale (xray console_commands.cpp:2068-2069).
local function _apply_time()
    if _is_frozen then return get_console():execute(CMD_FREEZE .. " on") end
    get_console():execute(string_format("%s %.3f", CMD_TIME, TIME_STEPS[_time_i]))
end

local function _set_time_step(delta)
    _time_i = math_max(1, math_min(#TIME_STEPS, _time_i + delta))
    _is_frozen = false
    _apply_time()
    _render_window()
end

local function _set_frozen(is_frozen)
    _is_frozen = is_frozen
    _apply_time()
    _render_window()
end

local function _reset_time()
    _time_i, _is_frozen = 1, false
    get_console():execute(CMD_TIME .. " 1")
end

local function _hide_head(obj)
    local bone = _find_head_bone(obj)
    if not bone then return end
    _shot.head = bone
    _shot.head_was = obj:bone_visible(bone)
    if _shot.head_was then obj:set_bone_visible(bone, false, true) end
end

local function _show_head()
    if not (_shot and _shot.head) then return end
    local obj = xobject.get_go(_shot.head_id)
    if obj then obj:set_bone_visible(_shot.head, _shot.head_was ~= false, true) end
    _shot.head = nil
end

-- The signed bone axis closest to the creature's facing: with three axes at right angles, the right one wins even with the head turned.
local function _compute_forward_axis(obj, bone_id)
    local hpb = obj:bone_direction(bone_id)
    local bone = matrix():setHPB(hpb.x, hpb.y, hpb.z)
    local facing = obj:direction()
    local best_name, best_sign, best_dot = "k", 1, -2
    for _, name in pairs({ "i", "j", "k" }) do
        local dot = bone[name]:dotproduct(facing)
        if dot > best_dot then best_name, best_sign, best_dot = name, 1, dot end
        if -dot > best_dot then best_name, best_sign, best_dot = name, -1, -dot end
    end
    return best_name, best_sign
end

-- The POV view: along the calibrated bone axis, the horizon level.
local function _get_pov_hpb(obj)
    local hpb = obj:bone_direction(_shot.bone_id)
    local bone = matrix():setHPB(hpb.x, hpb.y, hpb.z)
    local fwd = vector():set(bone[_shot.axis]):mul(_shot.axis_sign)
    return vector():set(fwd:getH(), fwd:getP(), 0), fwd
end

-- @novalidate(conventions.bool_positional, reason:"engine signature, hud and hud_affect off, xray level_script.cpp:1003")
local function _apply_camera(pos, hpb, calm)
    level.set_cam_custom_position_direction(pos, hpb, calm, false, false)
end

-- Keep the target online: the player moves above it only once it walks past the follow radius.
local function _apply_follow(obj)
    local actor = db.actor
    local pos, actor_pos = obj:position(), actor:position()
    if actor_pos:distance_to_sqr(pos) <= _shot.follow_sqr and not _shot.is_following then return end
    _shot.is_following = true
    local above = vector():set(pos)
    above.y = above.y + FOLLOW_HEIGHT
    if actor_pos:distance_to_sqr(above) > FOLLOW_SLACK_SQR then actor:set_actor_position(above) end
end

local function _update_pov(obj)
    local hpb, fwd = _get_pov_hpb(obj)
    local pos = vector():set(obj:bone_position(_shot.bone_id)):mad(fwd, FORWARD_OFFSET)
    _apply_camera(pos, hpb, _calm)
end

local function _update_chase(obj)
    local facing = vector():set(obj:direction())
    facing.y = 0
    facing:normalize()
    local pos = vector():set(obj:position()):mad(facing, -CHASE_BACK)
    pos.y = pos.y + CHASE_UP
    local point = _get_aim_point(obj):mad(facing, CHASE_AHEAD)
    _apply_camera(pos, _get_look_hpb(pos, point), _calm)
end

local function _update_orbit(obj, now)
    local angle = _shot.angle + (now - _shot.start) / 1000 / ORBIT_LAP_S * 2 * math_pi
    local center = obj:position()
    local pos = vector():set(center.x + ORBIT_RADIUS * math_cos(angle), center.y + ORBIT_UP, center.z + ORBIT_RADIUS * math_sin(angle))
    _apply_camera(pos, _get_look_hpb(pos, _get_aim_point(obj)), _calm)
end

-- One coordinate of the Catmull-Rom curve between b and c at frac, a and d the outer points.
local function _compute_catmull_axis(a, b, c, d, frac)
    local frac2, frac3 = frac * frac, frac * frac * frac
    return 0.5 * (2 * b + (c - a) * frac + (2 * a - 5 * b + 4 * c - d) * frac2 + (3 * b - a - 3 * c + d) * frac3)
end

local function _compute_catmull(p0, p1, p2, p3, frac)
    return vector():set(_compute_catmull_axis(p0.x, p1.x, p2.x, p3.x, frac), _compute_catmull_axis(p0.y, p1.y, p2.y, p3.y, frac),
        _compute_catmull_axis(p0.z, p1.z, p2.z, p3.z, frac))
end

-- Smoothstep ease over the whole path.
local function _compute_ease(u)
    return u * u * (3 - 2 * u)
end

local function _update_path(obj, now)
    local count = #_keys
    local total_s = (count - 1) * PATH_SEGMENT_S
    local elapsed = (now - _shot.start) / 1000
    if elapsed >= total_s then
        if not _is_loop then return false end
        _shot.start, elapsed = now, 0
    end
    local progress = _compute_ease(elapsed / total_s) * (count - 1)
    local seg = math_min(count - 1, math_floor(progress) + 1)
    local frac = progress - (seg - 1)
    local p0, p1 = _keys[math_max(1, seg - 1)], _keys[seg]
    local p2, p3 = _keys[seg + 1], _keys[math_min(count, seg + 2)]
    local pos = _compute_catmull(p0.pos, p1.pos, p2.pos, p3.pos, frac)
    local hpb
    if _is_look_at and obj then
        hpb = _get_look_hpb(pos, _get_aim_point(obj))
    else
        local dir = vector():set(p1.dir):lerp(p1.dir, p2.dir, frac)
        hpb = vector():set(dir:getH(), dir:getP(), 0)
    end
    _apply_camera(pos, hpb, CALM_NONE)
    return true
end

-- Depth of field: focus on the target at most every DOF_PERIOD_MS.
local function _update_dof(obj, now)
    if not (_dof and obj) or now < _dof.next then return end
    _dof.next = now + DOF_PERIOD_MS
    local focus = math_max(0.5, device().cam_pos:distance_to(obj:position()))
    get_console():execute(string_format("%s %.2f,%.2f,%.2f", CMD_DOF, focus * DOF_NEAR_SHARE, focus, focus * DOF_FAR_SHARE))
end

local function _get_squad_members(obj)
    local list = {}
    local squad = xsquad.get_member_squad(obj:id())
    if not (squad and squad:npc_count() > 0) then return list end
    for member in squad:squad_members() do
        local member_obj = xobject.get_go(member.id)
        if _is_filmable(member_obj) and IsStalker(member_obj) == IsStalker(obj) then list[#list + 1] = member_obj end
    end
    table_sort(list, function(a, b) return a:id() < b:id() end)
    return list
end

local function _get_squad_leads()
    local by_squad, list = {}, {}
    for id, st in pairs(db.storage) do
        local obj = st.object
        if _is_filmable(obj) then
            local se = xobject.get_se(id)
            local gid = se and se.group_id
            if gid and gid ~= INVALID_ID and (not by_squad[gid] or id < by_squad[gid]:id()) then by_squad[gid] = obj end
        end
    end
    for gid, obj in pairs(by_squad) do list[#list + 1] = { gid = gid, obj = obj } end
    table_sort(list, function(a, b) return a.gid < b.gid end)
    return list
end

local function _find_index(list, match)
    for i = 1, #list do
        if match(list[i]) then return i end
    end
    return nil
end

local function _get_neighbor(list, i, delta)
    return list[((i - 1 + delta) % #list) + 1]
end

local function _find_nearest(pos, skip_id, is_stalker)
    local best, best_dist_sqr
    for id, st in pairs(db.storage) do
        local obj = st.object
        if id ~= skip_id and _is_filmable(obj) and (is_stalker == nil or IsStalker(obj) == is_stalker) then
            local dist_sqr = obj:position():distance_to_sqr(pos)
            if not best_dist_sqr or dist_sqr < best_dist_sqr then best, best_dist_sqr = obj, dist_sqr end
        end
    end
    return best
end

local _update_shot, _stop_freecam

--- End the running camera mode; the release waits for a live level and actor, since the engine reads Actor() unchecked (xray level_script.cpp:1031-1032).
local function _stop_shot()
    if not _shot then return end
    UnregisterScriptCallback("actor_on_update", _update_shot)
    _show_head()
    if level.present() and db.actor then level.remove_cam_custom_position_direction() end
    get_console():execute(string_format("%s %.1f", CMD_FOV, _shot.fov_was))
    get_console():execute(string_format("%s %.3f", CMD_NEAR, _shot.near_was))
    local obj = _get_target()
    if obj and db.actor and _shot.is_following then db.actor:set_actor_position(obj:position()) end
    log.info("[SHOT] stop mode=%s", _mode)
    _shot, _mode = nil, nil
    _render_window()
end

--- Start a camera mode on obj, or retarget the running one; POV calibrates the head bone, the others aim at the target.
local function _start_shot(mode, obj)
    if mode ~= MODE_PATH and not _is_filmable(obj) then return _show_tip("MovieTool: aim at a living stalker or mutant") end
    if mode == MODE_PATH and #_keys < 2 then return _show_tip("MovieTool: add two keys or more first") end
    local bone, bone_id
    if mode == MODE_POV then
        bone, bone_id = _find_bone(obj)
        if not bone then return _show_tip("MovieTool: no camera bone on " .. _get_name(obj)) end
    end
    if _shot then
        _show_head()
    else
        _stop_freecam()
        _start_film()
        local limit = alife():switch_distance() * FOLLOW_SHARE
        _shot = { fov_was = get_console():get_float(CMD_FOV), near_was = get_console():get_float(CMD_NEAR), follow_sqr = limit * limit }
        RegisterScriptCallback("actor_on_update", _update_shot)
    end
    _mode = mode
    if obj then _target_id = obj:id() end
    _shot.start, _shot.angle, _shot.death_until, _shot.killer_id = _get_now(), 0, nil, nil
    if mode == MODE_ORBIT then
        local offset = vector():set(device().cam_pos):sub(obj:position())
        _shot.angle = math_atan2(offset.z, offset.x)
    end
    if mode == MODE_POV then
        _shot.bone_id, _shot.head_id = bone_id, obj:id()
        _shot.axis, _shot.axis_sign = _compute_forward_axis(obj, bone_id)
        if IS_HEAD_CAMERA[bone] then _hide_head(obj) end
    end
    get_console():execute(string_format("%s %.3f", CMD_NEAR, mode == MODE_POV and POV_NEAR or _shot.near_was))
    get_console():execute(string_format("%s %.1f", CMD_FOV, _fov))
    log.info("[SHOT] mode=%s target=%s", mode, obj and _get_name(obj) or "-")
    _render_window()
end

local function _find_next_after_death(obj)
    local killer = _shot.killer_id and xobject.get_go(_shot.killer_id)
    if _is_filmable(killer) then return killer end
    local pos, id = obj:position(), obj:id()
    return _find_nearest(pos, id, IsStalker(obj)) or _find_nearest(pos, id, nil)
end

-- A dead target: hold on the body while the death cam runs, then hand off or stop; true while the frame should go on.
local function _check_target(obj, now)
    if not obj then
        _stop_shot()
        return false
    end
    if obj:alive() then return true end
    if _is_death_cam and not _shot.death_until then _shot.death_until = now + DEATH_HOLD_MS end
    if _is_death_cam and now < _shot.death_until then return true end
    local next_obj = _find_next_after_death(obj)
    if next_obj then _start_shot(_mode, next_obj) else _stop_shot() end
    return false
end

--- One frame of the running mode: the death hold and hand-off, the camera, the follow and the focus.
_update_shot = function()
    if not (_shot and db.actor) then return end
    local now = _get_now()
    local obj = _get_target()
    if _mode ~= MODE_PATH and not _check_target(obj, now) then return end
    if _mode == MODE_POV then _update_pov(obj)
    elseif _mode == MODE_CHASE then _update_chase(obj)
    elseif _mode == MODE_ORBIT then _update_orbit(obj, now)
    elseif not _update_path(obj, now) then return _stop_shot() end
    if obj and (_mode ~= MODE_PATH or _is_look_at) then _apply_follow(obj) end
    _update_dof(obj, now)
end

--- Move to the target's neighbor: delta places through its squad, or through the level's squads when is_squad.
local function _select_target_neighbor(delta, is_squad)
    local obj = _get_target()
    if not (obj and _mode and _mode ~= MODE_PATH) then return end
    if is_squad then
        local leads = _get_squad_leads()
        if #leads == 0 then return end
        local se = xobject.get_se(obj:id())
        local i = _find_index(leads, function(entry) return se and entry.gid == se.group_id end)
        local pick = i and _get_neighbor(leads, i, delta) or leads[1]
        return _start_shot(_mode, pick.obj)
    end
    local members = _get_squad_members(obj)
    if #members < 2 then return end
    local i = _find_index(members, function(member) return member:id() == obj:id() end)
    if i then _start_shot(_mode, _get_neighbor(members, i, delta)) end
end

local function _set_killer(victim, who)
    if _shot and victim and victim:id() == _target_id then _shot.killer_id = who and who:id() end
end

local function _start_freecam()
    _stop_shot()
    _start_film()
    get_console():execute(CMD_DEMO_START)
    _is_freecam = true
    log.info("[FREECAM] on")
end

_stop_freecam = function()
    if not _is_freecam then return end
    get_console():execute(CMD_DEMO_STOP)
    _is_freecam = false
    log.info("[FREECAM] off")
end

local function _set_cam_mode(index)
    if not level.set_active_cam then return _show_tip("MovieTool: this exe has no camera mode switch") end
    level.set_active_cam(CAM_MODES[index])
    _cam_mode = index
    _render_window()
end

local function _add_path_key()
    local cam = device()
    _keys[#_keys + 1] = { pos = vector():set(cam.cam_pos), dir = vector():set(cam.cam_dir) }
    log.info("[PATH] key=%d pos=%.1f,%.1f,%.1f", #_keys, cam.cam_pos.x, cam.cam_pos.y, cam.cam_pos.z)
    _render_window()
end

local function _clear_path_keys()
    if _mode == MODE_PATH then _stop_shot() end
    _keys = {}
    _render_window()
end

local function _set_dof(is_on)
    if is_on and not _dof then
        _dof = { was_on = get_console():get_bool(CMD_DOF_ON), next = 0 }
        get_console():execute(CMD_DOF_ON .. " on")
    elseif not is_on and _dof then
        get_console():execute(CMD_DOF_ON .. (_dof.was_on and " on" or " off"))
        get_console():execute(CMD_DOF .. " " .. DOF_DEFAULT)
        _dof = nil
    end
    _render_window()
end

-- Step to the next filter, or off after the last.
local function _select_next_filter()
    if _filter_i > 0 then level.remove_pp_effector(FILTER_SLOT) end
    _filter_i = (_filter_i + 1) % (#FILTERS + 1)
    if _filter_i > 0 then
        level.add_pp_effector(FILTERS[_filter_i], FILTER_SLOT, true)
        level.set_pp_effector_factor(FILTER_SLOT, FILTER_FACTOR)
    end
    _render_window()
end

local function _set_shake(is_on)
    if is_on and not _is_shake then level.add_cam_effector(SHAKE_ANM, SHAKE_ID, true, "") end
    if not is_on and _is_shake then level.remove_cam_effector(SHAKE_ID) end
    _is_shake = is_on
    _render_window()
end

local function _set_bars(is_on)
    local hud = get_hud()
    if not hud then
        _bars = nil
        return
    end
    if is_on and not _bars then
        _bars = tz_movie_bars_wnd()
        hud:AddDialogToRender(_bars)
    elseif not is_on and _bars then
        hud:RemoveDialogToRender(_bars)
        _bars = nil
    end
    _render_window()
end

--- Stop every mode and put back what it changed: camera, film, time, lens and look.
local function _stop_all()
    _stop_freecam()
    _stop_shot()
    _stop_film()
    _reset_time()
    _set_dof(false)
    if _filter_i > 0 then
        level.remove_pp_effector(FILTER_SLOT)
        _filter_i = 0
    end
    _set_shake(false)
    _set_bars(false)
    _render_window()
end

local function _get_aimed()
    local obj = level.get_target_obj and level.get_target_obj()
    if _is_filmable(obj) then return obj end
    return db.actor and _find_nearest(db.actor:position(), nil, nil)
end

-- Hotkeys while a shot runs with the window closed; each press stops at this handler.
local function _on_before_key_press(dik, _, _, flags)
    if _is_window_open() or not (_mode or _is_freecam or _film) then return end
    local keys = DIK_keys
    local is_aimed_mode = _mode and _mode ~= MODE_PATH
    if is_aimed_mode and dik == keys.DIK_LEFT then _select_target_neighbor(-1, false)
    elseif is_aimed_mode and dik == keys.DIK_RIGHT then _select_target_neighbor(1, false)
    elseif is_aimed_mode and dik == keys.DIK_UP then _select_target_neighbor(1, true)
    elseif is_aimed_mode and dik == keys.DIK_DOWN then _select_target_neighbor(-1, true)
    elseif dik == keys.DIK_SUBTRACT then _set_time_step(1)
    elseif dik == keys.DIK_ADD then _set_time_step(-1)
    elseif dik == keys.DIK_MULTIPLY then _set_frozen(not _is_frozen)
    else return end
    flags.ret_value = false
end

local function _get_mode_text()
    local time = _is_frozen and "frozen" or (TIME_STEPS[_time_i] == 1 and "" or string_format("x%.2f", TIME_STEPS[_time_i]))
    local parts = (_film and "film " or "") .. (_mode or "") .. (_is_freecam and "free" or "") .. " " .. time
    return parts ~= " " and parts or "idle"
end

local function _write_shot(text)
    local actor = db.actor
    if not actor then return end
    local pos = actor:position()
    local obj = _get_target()
    local target = obj and _get_name(obj) or "-"
    local setup = string_format("mode=%s time=%s fov=%d calm=%d keys=%d dof=%s filter=%s shake=%s bars=%s", tostring(_mode or (_is_freecam and "free")),
        _is_frozen and "frozen" or tostring(TIME_STEPS[_time_i]), _fov, _calm, #_keys, tostring(_dof ~= nil),
        tostring(FILTERS[_filter_i] or "off"), tostring(_is_shake), tostring(_bars ~= nil))
    if not tz_ui.write_line(OUTPUT_TOOL, level.name(), "NOTE", string_format("%.2f %.2f %.2f", pos.x, pos.y, pos.z), target, setup, text) then return end
    xcui.push_line(_feed, string_format("%s %s %s", os_date("%H:%M:%S"), target, text or ""), FEED_MAX, FEED_CHARS)
    _render_window()
end

local function _try_open()
    if Check_UI() or not db.actor then return end
    _box = tz_movie_tool_wnd()
    _box:ShowDialog(true)
    Register_UI("tz_movie_tool_wnd", "tz_movie_tool", _box)
end

local function _on_key_press(key)
    if key == tz_mcm.get_config("movie_key") then _try_open() end
end

--- A save, a level change, the main menu or the player's death: everything stops and is put back.
local function _on_leave()
    _stop_all()
    Unregister_UI("tz_movie_tool_wnd")
end

class "tz_movie_bars_wnd" (CUIScriptWnd)

function tz_movie_bars_wnd:__init() super()
    self:SetWndRect(Frect():set(0, 0, 1024, 768))
    local xml = CScriptXmlInit()
    xml:ParseFile("tz_movie_tool.xml")
    xcui.build(xml, self, { { kind = "static", names = { "bar_top", "bar_bottom" } } })
end

class "tz_movie_tool_wnd" (CUIScriptWnd)

function tz_movie_tool_wnd:__init() super()
    self:SetWndRect(Frect():set(0, 0, 1024, 768))
    self:SetAutoDelete(true)
    self:init_controls()
    self:init_callbacks()
    self:render()
end

--- The window's controls in draw order.
function tz_movie_tool_wnd:get_layout()
    local lits = {}
    for i = 1, #TOGGLES do lits[i] = "lit_" .. TOGGLES[i] end
    return {
        { kind = "static", names = tz_ui.PANEL },
        { kind = "static", names = DECOR.statics },
        { kind = "text", names = { "lbl_target", "lbl_mode", "lbl_lens" } },
        { kind = "static", names = { "lamp_green", "lamp_red" } },
        { kind = "button", names = { "btn_film", "btn_time_down", "btn_time_up", "btn_freeze", "btn_hour", "btn_weather",
            "btn_pov", "btn_chase", "btn_orbit", "btn_freecam", "btn_prev", "btn_next", "btn_squad_prev", "btn_squad_next",
            "btn_key_add", "btn_path", "btn_loop", "btn_look_at", "btn_key_clear", "btn_death", "btn_stop",
            "btn_fov_down", "btn_fov_up", "btn_smooth_down", "btn_smooth_up", "btn_dof", "btn_filter", "btn_shake", "btn_bars",
            "btn_cam_1", "btn_cam_2", "btn_cam_3", "btn_screenshot", "btn_note", "btn_help" } },
        { kind = "static", names = lits },
        { kind = "edit", names = { "note" } },
        { kind = "text", names = xcui.get_names("feed_row_", FEED_MAX) },
    }
end

function tz_movie_tool_wnd:init_controls()
    local xml = CScriptXmlInit()
    xml:ParseFile("tz_movie_tool.xml")
    self.ui = xcui.build(xml, self, self:get_layout())
    self.feed_rows = xcui.get_controls(self.ui, xcui.get_names("feed_row_", FEED_MAX))
end

function tz_movie_tool_wnd:bind_click(name, fn)
    self:AddCallback(name, ui_events.BUTTON_CLICKED, fn, self)
end

--- A camera mode key: the window closes and the shot starts on the aimed creature, or the running target.
function tz_movie_tool_wnd:start_mode(mode)
    local obj = (mode == MODE_PATH and _get_target()) or _get_aimed()
    self:hide()
    _start_shot(mode, obj)
end

function tz_movie_tool_wnd:init_callbacks()
    self:bind_click("btn_film", function()
        if _film and not _mode and not _is_freecam then _stop_film() else _start_film() end
        self:render()
    end)
    self:bind_click("btn_time_down", function() _set_time_step(1) end)
    self:bind_click("btn_time_up", function() _set_time_step(-1) end)
    self:bind_click("btn_freeze", function() _set_frozen(not _is_frozen) end)
    self:bind_click("btn_hour", function() tz_commands.add_hours(1) end)
    self:bind_click("btn_weather", function() self:select_next_weather() end)
    self:bind_click("btn_pov", function() self:start_mode(MODE_POV) end)
    self:bind_click("btn_chase", function() self:start_mode(MODE_CHASE) end)
    self:bind_click("btn_orbit", function() self:start_mode(MODE_ORBIT) end)
    self:bind_click("btn_path", function() self:start_mode(MODE_PATH) end)
    self:bind_click("btn_freecam", function() self:select_freecam() end)
    self:bind_click("btn_prev", function() _select_target_neighbor(-1, false) end)
    self:bind_click("btn_next", function() _select_target_neighbor(1, false) end)
    self:bind_click("btn_squad_prev", function() _select_target_neighbor(-1, true) end)
    self:bind_click("btn_squad_next", function() _select_target_neighbor(1, true) end)
    self:bind_click("btn_key_add", function() _add_path_key() end)
    self:bind_click("btn_loop", function() _is_loop = not _is_loop; self:render() end)
    self:bind_click("btn_look_at", function() _is_look_at = not _is_look_at; self:render() end)
    self:bind_click("btn_key_clear", function() _clear_path_keys() end)
    self:bind_click("btn_death", function() _is_death_cam = not _is_death_cam; self:render() end)
    self:bind_click("btn_stop", function() _stop_all() end)
    self:bind_click("btn_fov_down", function() self:update_fov(-FOV_STEP) end)
    self:bind_click("btn_fov_up", function() self:update_fov(FOV_STEP) end)
    self:bind_click("btn_smooth_down", function() self:update_calm(-CALM_STEP) end)
    self:bind_click("btn_smooth_up", function() self:update_calm(CALM_STEP) end)
    self:bind_click("btn_dof", function() _set_dof(not _dof) end)
    self:bind_click("btn_filter", function() _select_next_filter() end)
    self:bind_click("btn_shake", function() _set_shake(not _is_shake) end)
    self:bind_click("btn_bars", function() _set_bars(not _bars) end)
    self:bind_click("btn_cam_1", function() _set_cam_mode(1) end)
    self:bind_click("btn_cam_2", function() _set_cam_mode(2) end)
    self:bind_click("btn_cam_3", function() _set_cam_mode(3) end)
    self:bind_click("btn_screenshot", function() self:run_screenshot() end)
    self:bind_click("btn_note", function()
        _write_shot(self.ui.note:GetText())
        self.ui.note:SetText("")
    end)
    self:bind_click("btn_help", function() tz_help.show_page("tz_movie_tool.xml", "st_tz_movie_tool_help_title", "st_tz_movie_tool_help") end)
end

--- The free camera takes the screen, so the window closes before it starts.
function tz_movie_tool_wnd:select_freecam()
    if _is_freecam then
        _stop_freecam()
        return self:render()
    end
    self:hide()
    _start_freecam()
end

function tz_movie_tool_wnd:select_next_weather()
    self.weather_i = ((self.weather_i or 0) % #WEATHERS) + 1
    tz_commands.set_weather(WEATHERS[self.weather_i])
end

--- The window closes, then the screenshot runs a moment later, so the window is not in the picture.
function tz_movie_tool_wnd:run_screenshot()
    self:hide()
    CreateTimeEvent("tz_movie_tool", "screenshot", 0.2, function()
        get_console():execute("screenshot")
        return true
    end)
end

function tz_movie_tool_wnd:update_fov(delta)
    _fov = math_max(FOV_MIN, math_min(FOV_MAX, _fov + delta))
    if _shot then get_console():execute(string_format("%s %.1f", CMD_FOV, _fov)) end
    self:render()
end

function tz_movie_tool_wnd:update_calm(delta)
    _calm = math_max(CALM_NONE, math_min(CALM_MAX, _calm + delta))
    self:render()
end

-- Light a toggle: its diode on and its label bright.
function tz_movie_tool_wnd:render_toggle(name, is_on)
    self.ui["lit_" .. name]:Show(is_on)
    local rgb = is_on and LABEL_LIT_RGB or LABEL_RGB
    self.ui["btn_" .. name]:TextControl():SetTextColor(xcui.get_color(rgb[1], rgb[2], rgb[3], 255))
end

function tz_movie_tool_wnd:render()
    local ui = self.ui
    local obj = _get_target()
    ui.lbl_target:SetText(xcui.get_clipped(obj and _get_name(obj) or "** NO TARGET **", 26))
    ui.lbl_mode:SetText(_get_mode_text())
    ui.lbl_lens:SetText(string_format("fov %d  calm %d  keys %d", _fov, _calm, #_keys))
    local states = { film = _film ~= nil, freeze = _is_frozen, pov = _mode == MODE_POV, chase = _mode == MODE_CHASE, orbit = _mode == MODE_ORBIT,
        freecam = _is_freecam, path = _mode == MODE_PATH, loop = _is_loop, look_at = _is_look_at, death = _is_death_cam, dof = _dof ~= nil,
        filter = _filter_i > 0, shake = _is_shake, bars = _bars ~= nil, cam_1 = _cam_mode == 1, cam_2 = _cam_mode == 2, cam_3 = _cam_mode == 3 }
    for i = 1, #TOGGLES do self:render_toggle(TOGGLES[i], states[TOGGLES[i]]) end
    xcui.set_lines(self.feed_rows, _feed)
    tz_ui.render_lamps(ui, _film ~= nil or _mode ~= nil or _is_freecam)
end

--- Esc closes the window when no edit box has focus; a running shot keeps running.
function tz_movie_tool_wnd:OnKeyboard(dik, action)
    local res = CUIScriptWnd.OnKeyboard(self, dik, action)
    if not xcui.is_close_key(res, dik, action) then return res end
    self:hide()
    return true
end

function tz_movie_tool_wnd:hide()
    self:HideDialog()
    Unregister_UI("tz_movie_tool_wnd")
end

function on_game_start()
    RegisterScriptCallback("on_key_press", _on_key_press)
    RegisterScriptCallback("on_before_key_press", _on_before_key_press)
    RegisterScriptCallback("npc_on_death_callback", _set_killer)
    RegisterScriptCallback("monster_on_death_callback", _set_killer)
    RegisterScriptCallback("save_state", _on_leave)
    RegisterScriptCallback("actor_on_net_destroy", _on_leave)
    RegisterScriptCallback("main_menu_on_init", _on_leave)
    RegisterScriptCallback("actor_on_before_death", _on_leave)
end
