--- tz_commands: parametrized console commands for testing and filming, run via `run_string tz_commands.<name>(...)` in debug mode.
--- @novalidate(conventions.unused_export, reason:"console commands, invoked by name via run_string")

local pairs, type, tostring, string_format, table_concat, getfenv = pairs, type, tostring, string.format, table.concat, getfenv
local math_random, math_cos, math_sin, math_pi, math_rad, math_floor =
    math.random, math.cos, math.sin, math.pi, math.rad, math.floor
local time_global, alife, level, ini_sys = time_global, alife, level, ini_sys
local IsStalker, IsMonster = IsStalker, IsMonster
local news_manager, xinventory, xstash, xlevel, xobject =
    news_manager, xinventory, xstash, xlevel, xobject
local xfs, getFS = xfs, getFS
local RegisterScriptCallback, UnregisterScriptCallback = RegisterScriptCallback, UnregisterScriptCallback

local INVALID_VERTEX = 4294967295

local AMMO_BOXES   = 6
local MONEY        = 100000
local RANK         = 30000
local DEFAULT_HOURS = 12
local KIT_MONEY    = "money"
local KIT_RANK     = "rank"
local WEATHER_FREEZE = "freeze"
local WEATHER_RESUME = "resume"
local PSY_HELMET   = "good_psy_helmet"
local COMMANDS_FILE = "testzone_commands.txt"

local LIFEPUMP_THRESHOLD = 0.5
local LIFEPUMP_DAMP      = 0.02

local ARENA_TICK       = 2
local ARENA_DIST       = 45
local ARENA_RING_MIN   = 10
local ARENA_RING_MAX   = 18
local CLEAR_NPCS_RADIUS = 100
local ARENA_MAX_SPAWN  = 8
local ARENA_SPREAD_DEG = 25
-- Cosmetic gear per combatant: artefact auras glow on camera, plus optics and NVG (at_test.script:14).
local ARENA_GEAR = { "af_gravi", "af_soul", "af_fireball", "af_electra_sparkler", "af_compass", "af_kevlar", "wpn_binoc", "device_torch_nv_1" }

-- Weapon kits: key -> { weapon section, ammo section, default ammo boxes }; ammo is always attached.
local WEAPONS = {
    pistol   = { "wpn_pm",     "ammo_9x18_fmj" },
    shotgun  = { "wpn_spas12", "ammo_12x70_buck" },
    rifle    = { "wpn_ak74",   "ammo_5.45x39_fmj" },
    smg      = { "wpn_mp5",    "ammo_9x18_fmj" },
    sniper   = { "wpn_svd",    "ammo_7.62x54_7h1" },
    silenced = { "wpn_pb",     "ammo_9x18_fmj", 3 },
}

-- show_commands catalog: group, param-name signature, and a runnable example per command; getfenv lists any missing here.
local CATALOG = {
    { "combat", "start_arena",       "count, dist, shuffle", "16, 45, 60" },
    { "combat", "stop_arena",        "",                     "" },
    { "combat", "spawn_mutant",      "species, count, dist", '"boar", 3' },
    { "combat", "clear_mutants",     "",                     "" },
    { "combat", "clear_npcs",        "radius",               "100" },
    { "combat", "start_mutant_arena","count, dist, wave",    "8" },
    { "combat", "stop_mutant_arena", "",                     "" },
    { "combat", "start_actor_drive", "mode, radius, period", '"strafe"' },
    { "combat", "stop_actor_drive",  "",                     "" },
    { "kit",    "add_kit",           "what, amount",         '"silenced", 3' },
    { "world",  "set_weather",       "key",                  '"rain"' },
    { "world",  "add_hours",         "hours",                "6" },
    { "warp",   "teleport_to_smart", "name",                 '"dar_angar"' },
    { "warp",   "teleport_to_stash", "",                     "" },
    { "unlock", "enable_north",      "",                     "" },
    { "unlock", "enable_travel",     "",                     "" },
    { "help",   "show_commands",     "",                     "" },
}

-- set_weather presets: key -> { AtmosFear cycle, its preset } (weather.script:23).
local WEATHER_PRESETS = {
    clear = { cycle = "clear", name = "w_clear1" },
    rain  = { cycle = "rain",  name = "w_rain1" },
    storm = { cycle = "storm", name = "w_storm1" },
    fog   = { cycle = "foggy", name = "w_foggy1" },
}

-- North psy-field / story deactivation flags; good_psy_helmet also zeroes each antenna (rad_psy_zone_1.ltx:7).
local NORTH_FLAGS = {
    "story_mode_disabled",
    "yan_labx16_switcher_1_off", "yan_labx16_switcher_2_off",
    "yan_labx16_switcher_3_off", "yan_labx16_switcher_primary_off",
    "bar_deactivate_radar_done",
    "warlab_deactivate_generators_done",
    "yantar_attack_start",
    "bar_in_done",
}

local MUTANT_DIST = 20

-- The actor-drive strafe orbit: radius in metres, seconds per lap (~3.1 m/s - evasive but still hittable).
local DRIVE_STRAFE_RADIUS = 3.0
local DRIVE_STRAFE_PERIOD = 6.0
local DRIVE_MODE_STRAFE = "strafe"
local DRIVE_MODE_STAND  = "stand"

-- spawn_mutant species words -> one plain spawn section each (squad_descr_default_mutants.ltx npc_random rosters).
local MUTANTS = {
    chimera = "chimera_normal", lurker = "lurker_2_normal",
    bloodsucker = "bloodsucker_green_normal", psysucker = "psysucker_2_normal",
    burer = "burer_normal", controller = "m_controller_normal",
    poltergeist = "m_poltergeist_normal_tele", dog = "dog_normal_red",
    pseudodog = "pseudodog_normal", psy_dog = "psy_dog_normal",
    boar = "boar_normal", snork = "snork_normal", gigant = "gigant_normal",
    cat = "cat_normal_a", flesh = "flesh_01a_normal", fracture = "fracture_normal",
    karlik = "m_karlik_e", tushkano = "tushkano_normal", zombie = "zombie_normal",
    rat = "rat_normal",
}

-- The mutant arena: maintain a live population on a ring and grow the species mix over time.
local MARENA_TICK      = 1
local MARENA_MAX_SPAWN = 6
local MARENA_WAVE_SEC  = 8
local MARENA_ROSTER    = { "bloodsucker", "dog", "cat", "chimera", "burer", "controller", "snork", "boar" }

-- Arena faction tier pools and the hostile matchups start_arena rolls.
local ARENA_POOLS = {
    army     = { "sim_default_military_1", "sim_default_military_2", "sim_default_military_3", "sim_default_military_4" },
    monolith = { "sim_default_monolith_1", "sim_default_monolith_2", "sim_default_monolith_3", "sim_default_monolith_4" },
    ecolog   = { "sim_default_ecolog_0", "sim_default_ecolog_1", "sim_default_ecolog_2", "sim_default_ecolog_3", "sim_default_ecolog_4" },
    renegade = { "sim_default_renegade_0", "sim_default_renegade_1", "sim_default_renegade_2" },
}
local ARENA_PAIRS = {
    { "army", "monolith" }, { "ecolog", "monolith" }, { "renegade", "monolith" }, { "army", "renegade" },
}

local _arena = { on = false, want = 0, dist = 0, shuffle_sec = 0, shuffle_at = 0,
                 center_lvid = nil, gvid = nil, side_dir = 0, side_a = "army", side_b = "monolith",
                 spawned = {} }

local _lifepump = { on = false, threshold = LIFEPUMP_THRESHOLD, damp = LIFEPUMP_DAMP, topups = 0 }

local _drive = { on = false, mode = DRIVE_MODE_STAND, anchor = nil, radius = 0, period = 0, start_at = 0 }
local _drive_v = vector()
local _aim = { on = false, away = false }
local _aim_v = vector()

local _mutants = {}

local _marena = { on = false, want = 0, center = nil, gvid = nil, pool = {}, stage = 0, wave_sec = 0, wave_at = 0 }

local function _show_tip(msg)
    local actor = db.actor
    if actor then news_manager.send_tip(actor, msg, nil, nil, 5000) end
end

local function _find_arena_pos(angle)
    local dir = vector():set(math_cos(angle), 0, math_sin(angle))
    local dist = ARENA_RING_MIN + math_random() * (ARENA_RING_MAX - ARENA_RING_MIN)
    local lvid = level.vertex_in_direction(_arena.center_lvid, dir, dist)
    if not lvid or lvid >= INVALID_VERTEX then return nil end
    return level.vertex_position(lvid), lvid
end

local function _select_arena_pair()
    local pair = ARENA_PAIRS[math_random(#ARENA_PAIRS)]
    _arena.side_a, _arena.side_b = pair[1], pair[2]
    _arena.shuffle_at = time_global() + _arena.shuffle_sec * 1000
    _show_tip(string_format("arena: %s vs %s", _arena.side_a, _arena.side_b))
end

local function _spawn_combatant(side)
    local faction = (side == "b") and _arena.side_b or _arena.side_a
    local pool = ARENA_POOLS[faction]
    local base = (side == "b") and (_arena.side_dir + math_pi) or _arena.side_dir
    local angle = base + math_rad((math_random() * 2 - 1) * ARENA_SPREAD_DEG)
    local pos, lvid = _find_arena_pos(angle)
    if not pos then return false end
    local sec = pool[math_random(#pool)]
    if not ini_sys:section_exist(sec) then return false end
    local sim = alife()
    local se = sim:create(sec, pos, lvid, _arena.gvid)
    if not se then return false end
    _arena.spawned[se.id] = { side = side, dead_seen = false }
    for i = 1, #ARENA_GEAR do
        if ini_sys:section_exist(ARENA_GEAR[i]) then sim:create(ARENA_GEAR[i], pos, lvid, _arena.gvid, se.id) end
    end
    return true
end

local function _release_arena()
    local sim = alife()
    local released = 0
    for id in pairs(_arena.spawned) do
        local se = xobject.get_se(id)
        if se then sim:release(se, true); released = released + 1 end
        _arena.spawned[id] = nil
    end
    return released
end

-- Count alive per side; release a corpse one tick after it is first seen dead so the kill reads on camera.
local function _update_census()
    local sim = alife()
    local alive_a, alive_b = 0, 0
    for id, rec in pairs(_arena.spawned) do
        local se = xobject.get_se(id)
        if not se or not se.alive then
            _arena.spawned[id] = nil
        elseif se:alive() then
            if rec.side == "a" then alive_a = alive_a + 1 else alive_b = alive_b + 1 end
        elseif rec.dead_seen then
            sim:release(se, true)
            _arena.spawned[id] = nil
        else
            rec.dead_seen = true
        end
    end
    return alive_a, alive_b
end

local function _spawn_wave(alive_a, alive_b)
    local budget = ARENA_MAX_SPAWN
    local half = math_floor(_arena.want / 2)
    local need_a, need_b = half - alive_a, half - alive_b
    while (need_a > 0 or need_b > 0) and budget > 0 do
        if need_a >= need_b and _spawn_combatant("a") then need_a = need_a - 1
        elseif need_a < need_b and _spawn_combatant("b") then need_b = need_b - 1 end
        budget = budget - 1
    end
end

local function _update_arena()
    if not _arena.on then return true end
    ResetTimeEvent("tz_arena", "tick", ARENA_TICK)
    if not db.actor then return false end
    if _arena.shuffle_sec > 0 and time_global() >= _arena.shuffle_at then
        _release_arena()
        _select_arena_pair()
    end
    local alive_a, alive_b = _update_census()
    _spawn_wave(alive_a, alive_b)
    return false
end

local function _spawn_creature(sim, section, center, gvid)
    local angle = math_random() * 2 * math_pi
    local ring = ARENA_RING_MIN + math_random() * (ARENA_RING_MAX - ARENA_RING_MIN)
    local lvid = level.vertex_in_direction(center, vector():set(math_cos(angle), 0, math_sin(angle)), ring)
    if not lvid or lvid >= INVALID_VERTEX then return false end
    local se = sim:create(section, level.vertex_position(lvid), lvid, gvid)
    if not se then return false end
    _mutants[se.id] = true
    return true
end

-- Scale an incoming hit so the tester survives while the hit still fires its callback (god mode zeroes the callback instead).
local function _apply_damp(s_hit)
    if s_hit and s_hit.power then s_hit.power = s_hit.power * _lifepump.damp end
end

-- Pin the tester to full every frame; a 0.1s tick leaves a gap a burst or psy spike kills through.
-- Health and a controller's psy drain are both engine-checked per frame, so actor_on_update closes it.
local function _reset_actor()
    local actor = db.actor
    if not actor then return end
    if actor.health < _lifepump.threshold then
        _lifepump.topups = _lifepump.topups + 1
    end
    actor.health = 1
    actor.power = 1
    actor.bleeding = 0
    actor.radiation = 0
    actor.psy_health = 1
end

-- Drive the actor every frame for an unattended test: "stand" pins the start spot, "strafe" auto-circles it.
-- set_actor_position(pos, true) skips collision and zeroes the velocity.
local function _update_actor_drive()
    local actor = db.actor
    if not (actor and _drive.anchor) then return end
    if _drive.mode == DRIVE_MODE_STRAFE then
        local ang = (time_global() - _drive.start_at) / 1000 * (2 * math_pi / _drive.period)
        _drive_v:set(_drive.anchor.x + _drive.radius * math_cos(ang), _drive.anchor.y,
                     _drive.anchor.z + _drive.radius * math_sin(ang))
        actor:set_actor_position(_drive_v, true)
    else
        actor:set_actor_position(_drive.anchor, true)
    end
end

-- Face the actor at the nearest live spawned mutant each frame via the camera (set_actor_direction sets cam_Active, the -getH idiom).
-- The aim read mutants use (xcombat.is_enemy_watching) follows the camera, so this opens the aim-gated moves in a harness. Keep a weapon out.
local function _update_actor_aim()
    local actor = db.actor
    if not actor then return end
    local ap = actor:position()
    local best, best_d_sqr
    for id in pairs(_mutants) do
        local mob = xobject.get_go(id)
        if mob and mob:alive() then
            local d_sqr = ap:distance_to_sqr(mob:position())
            if not best_d_sqr or d_sqr < best_d_sqr then best_d_sqr, best = d_sqr, mob end
        end
    end
    if not best then return end
    local mp = best:position()
    _aim_v:set(mp.x - ap.x, mp.y - ap.y, mp.z - ap.z)
    local yaw = -_aim_v:getH()
    if _aim.away then yaw = yaw + math_pi end
    actor:set_actor_direction(yaw)
end

-- Arszi Psy kills via its own pool with db.actor:kill() at zero (arszi_psy.script:205); the pins miss it.
local _arszi_zomb
local _ARSZI_KILL = "manage_zombification"
local function _disable_psy_death()
    if _arszi_zomb or not (arszi_psy and arszi_psy[_ARSZI_KILL]) then return end
    _arszi_zomb = arszi_psy[_ARSZI_KILL]
    arszi_psy[_ARSZI_KILL] = function() end
end
local function _enable_psy_death()
    if not _arszi_zomb then return end
    arszi_psy[_ARSZI_KILL] = _arszi_zomb
    _arszi_zomb = nil
end

-- Census the mutant arena's live creatures, releasing corpses, like the stalker arena's census.
local function _update_marena_census()
    local sim = alife()
    local alive = 0
    for id in pairs(_mutants) do
        local se = xobject.get_se(id)
        if not se then
            _mutants[id] = nil
        elseif se:alive() then
            alive = alive + 1
        else
            sim:release(se, true)
            _mutants[id] = nil
        end
    end
    return alive
end

-- Add the next roster species to the active spawn pool: the escalation folded in from the wave spawner.
local function _add_marena_species()
    if _marena.stage >= #MARENA_ROSTER then return end
    _marena.stage = _marena.stage + 1
    local word = MARENA_ROSTER[_marena.stage]
    _marena.pool[#_marena.pool + 1] = MUTANTS[word] or word
    _marena.wave_at = time_global() + _marena.wave_sec * 1000
    _show_tip(string_format("mutant arena: +%s (%d species)", word, #_marena.pool))
end

local function _update_mutant_arena()
    if not _marena.on then return true end
    ResetTimeEvent("tz_marena", "tick", MARENA_TICK)
    if not db.actor then return false end
    if _marena.wave_sec > 0 and time_global() >= _marena.wave_at then _add_marena_species() end
    local alive = _update_marena_census()
    local sim = alife()
    local budget = MARENA_MAX_SPAWN
    while alive < _marena.want and budget > 0 and #_marena.pool > 0 do
        local section = _marena.pool[math_random(#_marena.pool)]
        if _spawn_creature(sim, section, _marena.center, _marena.gvid) then alive = alive + 1 end
        budget = budget - 1
    end
    return false
end

-- Release one NPC within radius_sqr of the actor, skipping the actor, companions and non-combatants; returns 1 on release, else 0.
local function _release_clearable_npc(sim, npc_id, actor_pos, radius_sqr, actor_id)
    if npc_id == actor_id then return 0 end
    local npc = xobject.get_go(npc_id)
    if not npc or not npc:alive() then return 0 end
    if npc:position():distance_to_sqr(actor_pos) > radius_sqr then return 0 end
    local is_stalker = IsStalker(npc)
    if not (is_stalker or IsMonster(npc)) then return 0 end
    if is_stalker and xcreature.is_companion(npc) then return 0 end
    local se = xobject.get_se(npc_id)
    if not se then return 0 end
    sim:release(se, true)
    return 1
end

--- Give the actor a keyed kit; guns include ammo, or use the money and rank keys, or a raw item section.
function add_kit(what, amount)
    local actor = db.actor
    if not actor then return _show_tip("Not in game") end
    if what == KIT_MONEY then
        actor:give_money(amount or MONEY)
        return _show_tip(string_format("money +%d", amount or MONEY))
    end
    if what == KIT_RANK then
        actor:set_character_rank(amount or RANK)
        return _show_tip(string_format("rank set %d", amount or RANK))
    end
    local id = actor:id()
    local weapon = WEAPONS[what]
    if weapon then
        local boxes = amount or weapon[3] or AMMO_BOXES
        xinventory.create_item(weapon[1], id)
        for _ = 1, boxes do xinventory.create_item(weapon[2], id) end
        return _show_tip(string_format("%s + %d ammo", what, boxes))
    end
    if not ini_sys:section_exist(what) then return _show_tip("no section " .. tostring(what)) end
    for _ = 1, (amount or 1) do xinventory.create_item(what, id) end
    _show_tip(string_format("%s x%d", what, amount or 1))
end

--- Spawn count creatures of a species word (or a raw section) on a ring around a point dist metres ahead.
function spawn_mutant(species, count, dist)
    local actor = db.actor
    if not actor then return _show_tip("Not in game") end
    local section = MUTANTS[species] or species
    if not section or not ini_sys:section_exist(section) then
        return _show_tip("no section " .. tostring(species))
    end
    local fdir = actor:direction()
    local apos = actor:position()
    local ahead = dist or MUTANT_DIST
    local cvid = level.vertex_id(vector():set(apos.x + fdir.x * ahead, apos.y, apos.z + fdir.z * ahead))
    local center = (cvid ~= INVALID_VERTEX) and cvid or actor:level_vertex_id()
    local gvid = actor:game_vertex_id()
    local sim = alife()
    local made = 0
    for _ = 1, (count or 1) do
        if _spawn_creature(sim, section, center, gvid) then made = made + 1 end
    end
    _show_tip(string_format("%s x%d @%dm", section, made, ahead))
end

--- Release every creature spawn_mutant made.
function clear_mutants()
    local sim = alife()
    local released = 0
    for id in pairs(_mutants) do
        local se = xobject.get_se(id)
        if se then sim:release(se, true); released = released + 1 end
        _mutants[id] = nil
    end
    _show_tip(string_format("released %d", released))
end

--- Release every stalker and monster within radius metres of the actor, default 100, except the actor and his companions.
--- It clears an area for a clean test and removes quest NPCs in range too, so use it deliberately.
function clear_npcs(radius)
    local actor = db.actor
    if not actor then return _show_tip("Not in game") end
    radius = radius or CLEAR_NPCS_RADIUS
    local actor_pos = actor:position()
    local actor_id = actor:id()
    local radius_sqr = radius * radius
    local sim = alife()
    local released = 0
    for npc_id in pairs(db.storage) do
        released = released + _release_clearable_npc(sim, npc_id, actor_pos, radius_sqr, actor_id)
    end
    _show_tip(string_format("released %d npcs within %dm", released, radius))
end

--- Keep count combatants fighting half against half on a ring, reshuffling factions every shuffle seconds.
function start_arena(count, dist, shuffle)
    local actor = db.actor
    if not actor then return _show_tip("Not in game") end
    if not count or count < 2 then return _show_tip("arena: pass a count like start_arena(16)") end
    _arena.want = count
    _arena.dist = dist or ARENA_DIST
    _arena.shuffle_sec = shuffle or 0
    _arena.side_dir = math_random() * 2 * math_pi
    local fdir = actor:direction()
    local apos = actor:position()
    local cvid = level.vertex_id(vector():set(apos.x + fdir.x * _arena.dist, apos.y, apos.z + fdir.z * _arena.dist))
    _arena.center_lvid = (cvid ~= INVALID_VERTEX) and cvid or actor:level_vertex_id()
    _arena.gvid = actor:game_vertex_id()
    _arena.on = true
    _select_arena_pair()
    RemoveTimeEvent("tz_arena", "tick")
    CreateTimeEvent("tz_arena", "tick", 1, _update_arena)
    _show_tip(string_format("arena: %d combatants @%dm", count, _arena.dist))
end

--- Stop the arena and release every NPC it spawned.
function stop_arena()
    if not _arena.on then return end
    _arena.on = false
    RemoveTimeEvent("tz_arena", "tick")
    _show_tip(string_format("arena stopped, released %d", _release_arena()))
end

--- Keep count mutants fighting you on a ring, adding a new species to the mix every wave seconds.
function start_mutant_arena(count, dist, wave)
    local actor = db.actor
    if not actor then return _show_tip("Not in game") end
    if not count or count < 1 then return _show_tip("arena: pass a count like start_mutant_arena(8)") end
    _marena.want = count
    _marena.wave_sec = wave or MARENA_WAVE_SEC
    local fdir = actor:direction()
    local apos = actor:position()
    local ahead = dist or MUTANT_DIST
    local cvid = level.vertex_id(vector():set(apos.x + fdir.x * ahead, apos.y, apos.z + fdir.z * ahead))
    _marena.center = (cvid ~= INVALID_VERTEX) and cvid or actor:level_vertex_id()
    _marena.gvid = actor:game_vertex_id()
    _marena.pool = {}
    _marena.stage = 0
    _marena.wave_at = time_global()
    _marena.on = true
    RemoveTimeEvent("tz_marena", "tick")
    CreateTimeEvent("tz_marena", "tick", 1, _update_mutant_arena)
    _show_tip(string_format("mutant arena: %d mutants @%dm, +species every %ds", count, ahead, _marena.wave_sec))
end

--- Stop the mutant arena and release every creature it spawned.
function stop_mutant_arena()
    if not _marena.on then return end
    _marena.on = false
    RemoveTimeEvent("tz_marena", "tick")
    clear_mutants()
end

--- Keep the tester alive: pin health/power/bleeding/radiation/psy_health every frame and damp each hit.
--- Also suppress Arszi's psy-death kill, so controllers and antennas cannot drop the tester.
function start_lifepump(threshold, damp)
    if not db.actor then return _show_tip("Not in game") end
    _lifepump.threshold = threshold or LIFEPUMP_THRESHOLD
    _lifepump.damp = damp or LIFEPUMP_DAMP
    _lifepump.topups = 0
    _lifepump.on = true
    RegisterScriptCallback("actor_on_before_hit", _apply_damp)
    RegisterScriptCallback("actor_on_update", _reset_actor)
    _disable_psy_death()
    _show_tip(string_format("lifepump on @%.2f damp=%.2f", _lifepump.threshold, _lifepump.damp))
end

--- Stop the life pump and restore full incoming damage.
function stop_lifepump()
    if not _lifepump.on then return end
    _lifepump.on = false
    UnregisterScriptCallback("actor_on_before_hit", _apply_damp)
    UnregisterScriptCallback("actor_on_update", _reset_actor)
    _enable_psy_death()
    _show_tip(string_format("lifepump off, %d topups", _lifepump.topups))
end

--- Drive the tester unattended from his current spot: "stand" pins him there, "strafe" auto-circles it at radius m over period s.
function start_actor_drive(mode, radius, period)
    local actor = db.actor
    if not actor then return _show_tip("Not in game") end
    local apos = actor:position()
    _drive.mode = (mode == DRIVE_MODE_STRAFE) and DRIVE_MODE_STRAFE or DRIVE_MODE_STAND
    _drive.anchor = vector():set(apos.x, apos.y, apos.z)
    _drive.radius = radius or DRIVE_STRAFE_RADIUS
    _drive.period = period or DRIVE_STRAFE_PERIOD
    _drive.start_at = time_global()
    if not _drive.on then
        _drive.on = true
        RegisterScriptCallback("actor_on_update", _update_actor_drive)
    end
    _show_tip(string_format("actor drive: %s", _drive.mode))
end

--- Stop driving the tester and hand control back.
function stop_actor_drive()
    if not _drive.on then return end
    _drive.on = false
    UnregisterScriptCallback("actor_on_update", _update_actor_drive)
    _show_tip("actor drive off")
end

--- Face the actor at the nearest spawned mutant every frame, so the aim-gated mutant moves can fire in a harness. Needs a weapon out.
function start_actor_aim(away)
    local actor = db.actor
    if not actor then return _show_tip("Not in game") end
    _aim.away = away and true or false
    if not _aim.on then
        _aim.on = true
        RegisterScriptCallback("actor_on_update", _update_actor_aim)
    end
    _show_tip(_aim.away and "actor aim: away" or "actor aim: on")
end

--- Stop facing the actor at mutants and hand the camera back.
function stop_actor_aim()
    if not _aim.on then return end
    _aim.on = false
    UnregisterScriptCallback("actor_on_update", _update_actor_aim)
    _show_tip("actor aim: off")
end

--- Set the weather to a preset key (clear, rain, storm, fog), or freeze / resume the dynamic cycle.
function set_weather(key)
    if not db.actor then return _show_tip("Not in game") end
    if key == WEATHER_FREEZE then weather.pause(true); return _show_tip("weather frozen") end
    if key == WEATHER_RESUME then weather.pause(false); return _show_tip("weather resumed") end
    local preset = WEATHER_PRESETS[key]
    if not preset then return _show_tip("weather keys: clear rain storm fog freeze resume") end
    local manager = level_weathers and level_weathers.get_weather_manager and level_weathers.get_weather_manager()
    if manager then manager.cycle = preset.cycle end
    level.set_weather(preset.name, true)
    _show_tip("weather " .. key)
end

--- Advance the game clock by hours hours.
function add_hours(hours)
    if not db.actor then return _show_tip("Not in game") end
    hours = hours or DEFAULT_HOURS
    local before = level.get_time_hours()
    level.change_game_time(0, hours, 0)
    _show_tip(string_format("+%dh (%02d -> %02d)", hours, before, level.get_time_hours()))
end

--- Warp to a smart terrain by name on any level.
function teleport_to_smart(name)
    if not db.actor then return _show_tip("Not in game") end
    local smart = SIMBOARD and SIMBOARD.smarts_by_names and SIMBOARD.smarts_by_names[name]
    if not smart then return _show_tip("no smart " .. tostring(name)) end
    _show_tip("warping to " .. tostring(name))
    ChangeLevel(smart.position, smart.m_level_vertex_id, smart.m_game_vertex_id, VEC_ZERO, true)
end

--- Warp to a random stash on the current level.
function teleport_to_stash()
    local actor = db.actor
    if not actor then return _show_tip("Not in game") end
    if not (xstash and xstash.find_stashes) then return _show_tip("xstash unavailable") end
    local se_actor = alife():actor()
    local lvid = se_actor and xlevel.get_level_id(se_actor)
    local list = xstash.find_stashes(actor:position(), { max_distance = 100000, max_count = 100000, level_id = lvid })
    if not list or #list == 0 then return _show_tip("no stashes on this level") end
    local stash = list[math_random(#list)]
    actor:set_actor_position(stash.position)
    _show_tip(string_format("%s stash", stash.filled and "filled" or "empty"))
end

--- Unlock the north by granting every psy-field flag and giving good_psy_helmet.
function enable_north()
    local actor = db.actor
    if not actor then return _show_tip("Not in game") end
    for i = 1, #NORTH_FLAGS do actor:give_info_portion(NORTH_FLAGS[i]) end
    if not actor:object(PSY_HELMET) then xinventory.create_item(PSY_HELMET, actor:id()) end
    _show_tip("north unlocked: flags + good_psy_helmet")
end

--- Unlock all fast-travel waypoints.
function enable_travel()
    if not db.actor then return _show_tip("Not in game") end
    ui_options.set("gameplay/fast_travel/state", 2)
    game_fast_travel.update_settings()
    _show_tip("fast travel unlocked")
end

--- Show the command list on screen and write a paste-ready run_string sheet to appdata/logs/testzone_commands.txt.
function show_commands()
    local actor = db.actor
    if not actor then return _show_tip("Not in game") end
    local tip_lines, sheet_lines, listed, last_group = {}, {}, {}, nil
    for i = 1, #CATALOG do
        local group, name, params, example = CATALOG[i][1], CATALOG[i][2], CATALOG[i][3], CATALOG[i][4]
        if group ~= last_group then tip_lines[#tip_lines + 1] = group .. ":"; last_group = group end
        tip_lines[#tip_lines + 1] = "  " .. name .. "(" .. params .. ")"
        sheet_lines[#sheet_lines + 1] = "run_string tz_commands." .. name .. "(" .. params .. ")"
        if example ~= "" then
            tip_lines[#tip_lines + 1] = "  " .. name .. "(" .. example .. ")"
            sheet_lines[#sheet_lines + 1] = "run_string tz_commands." .. name .. "(" .. example .. ")"
        end
        listed[name] = true
    end
    for name, value in pairs(getfenv(1)) do
        if type(value) == "function" and not listed[name] then
            tip_lines[#tip_lines + 1] = "  " .. name .. "() [unlisted]"
            sheet_lines[#sheet_lines + 1] = "run_string tz_commands." .. name .. "()"
        end
    end
    xfs.write_file(getFS():update_path("$logs$", "") .. COMMANDS_FILE, table_concat(sheet_lines, "\n") .. "\n")
    news_manager.send_tip(actor, table_concat(tip_lines, "\n"), nil, nil, 30000)
end
