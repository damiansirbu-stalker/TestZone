--- tz_commands: one-shot console commands for crash repro and spotchecks, run via `run_string tz_commands.<name>()` in debug mode

local ipairs, string_format, ini_sys = ipairs, string.format, ini_sys

local log = xlog.get_logger("TestZone.commands", { outfile = "testzone.log" })

local function _tip(msg)
    local actor = db.actor
    if actor then news_manager.send_tip(actor, msg, nil, nil, 5000) end
end

local function _spawn_count(sec, id, count)
    for _ = 1, count do xinventory.create_item(sec, id) end
end

local function _spawn(items, label)
    local actor = db.actor
    if not actor then
        log:info("%s SKIP no_actor", label)
        return 0, 0
    end
    local id = actor:id()
    local spawned, skipped = 0, 0
    for _, item in ipairs(items) do
        if not ini_sys:section_exist(item.sec) then
            log:info("%s SKIP missing section=%s", label, item.sec)
            skipped = skipped + 1
        else
            _spawn_count(item.sec, id, item.count)
            spawned = spawned + 1
        end
    end
    return spawned, skipped
end

-- Keep Crafting Window Opened (mod 143) crash repro: multi-use cooking tools + fuel + raw parts + repair kits.
local KCW_ITEMS = {
    { sec = "cooking",                   count = 1 },
    { sec = "army_bowler",               count = 1 },
    { sec = "charcoal",                  count = 3 },
    { sec = "kerosene",                  count = 2 },
    { sec = "mutant_part_flesh_meat",    count = 20 },
    { sec = "mutant_part_boar_chop",     count = 20 },
    { sec = "mutant_part_tushkano_meat", count = 20 },
    { sec = "flask",                     count = 10 },
    { sec = "cleaning_kit_s",            count = 2 },
    { sec = "toolkit_s",                 count = 2 },
    { sec = "sewing_kit_a",              count = 2 },
}

--- @novalidate(code.unused_export, reason:"console command")
function kit_kcw()
    local spawned, skipped = _spawn(KCW_ITEMS, "kit_kcw")
    log:info("kit_kcw spawned=%d skipped=%d", spawned, skipped)
    _tip(string_format("Kit KCW: %d items, %d skipped", spawned, skipped))
end
