--- tz_geo_tool: GeoTool - every place check live at your spot, and notes with the position and the readings, into one file. Settings in MCM TestZone > GeoTool.

local string_format, table_concat = string.format, table.concat
local tostring, ipairs, math_floor, math_abs = tostring, ipairs, math.floor, math.abs
local os_date, RegisterScriptCallback = os.date, RegisterScriptCallback

-- The prefix of this tool's file per game run in the logs folder (tz_ui.write_line).
local OUTPUT_TOOL = "geo_tool"
local EV          = "tz_geo_tool"
local RQ_STATIC   = 2
local STOP_SHORT  = 0.4
-- The last-lines screen: the newest records written, clipped to the row width.
local FEED_MAX    = 2
local FEED_CHARS  = 31
-- The checks in window order, one row each on the readings screen.
local CHECK_ORDER = { "smart", "base_owner", "is_indoor", "roof", "roof_walls", "underground",
    "surge_cover", "safe_cover", "rain", "sky" }
-- Thresholds: chest above the feet, a roof this close counts as indoor, ray reach, the engine's indoor sky cutoff (xray/GamePersistent.cpp:316 mt, :315 dev).
local CHEST_HEIGHT, ROOF_NEAR, SKY_RANGE, SKY_INDOOR_BELOW = 1.51, 4, 40, 0.05
-- xcombat.is_indoor counts a wall within this distance (xcombat.script:101); base owners count within this radius (dd_test.script:202).
local WALL_NEAR, BASE_OWNER_RADIUS = 5, 80
-- The position screen: three axes of four digits each, drawn with the dosimeter's digit textures.
local AXES, AXIS_DIGITS, AXIS_MAX = 3, 4, 9999
-- Decor the window draws and never touches again: the panel frame, the screens' rim and glass.
local DECOR = { statics = { "hdr_tool", "scr_position_rim", "scr_position_glass", "lbl_axis_1", "lbl_axis_2", "lbl_axis_3",
    "scr_readings_rim", "scr_readings_glass", "scr_note_rim", "scr_note_glass", "note_plus_h", "note_plus_v",
    "scr_feed_rim", "scr_feed_glass" } }

local _readings = {}
local _feed = {}
local _box = nil
local _live_on = false

local function _get_setting(key)
    return tz_mcm.get_config("geo_" .. key)
end

-- One static-geometry ray; distance to the first hit within range, or nil (the ray_pick class reads 0 on a miss, raypick.cpp:32).
local function _get_ray_distance(pos, dir, range)
    local ray = ray_pick()
    ray:set_flags(RQ_STATIC)
    ray:set_position(pos)
    ray:set_direction(dir)
    ray:set_range(range)
    ray:query()
    local hit = ray:get_distance()
    return (hit > 0 and hit <= range) and hit or nil
end

-- Roof height above the chest from an up ray, or a down ray from above when the up ray misses a single-sided roof.
local function _get_roof_height(pos)
    local chest = vector():set(pos.x, pos.y + CHEST_HEIGHT, pos.z)
    local up = _get_ray_distance(chest, vector():set(0, 1, 0), SKY_RANGE)
    if up then return up, "up" end
    local top = vector():set(pos.x, chest.y + SKY_RANGE, pos.z)
    local down = _get_ray_distance(top, vector():set(0, -1, 0), SKY_RANGE - STOP_SHORT)
    if down then return SKY_RANGE - down, "down" end
    return nil, "none"
end

local function _get_place_word(indoor)
    return indoor and "indoor" or "outdoor"
end

local function _get_yes_no(on)
    return on and "yes" or "no"
end

local function _get_nearest_smart()
    local ns = smart_terrain.nearest_to_actor_smart
    return ns and ns.id and xobject.get_se(ns.id), ns and ns.dist
end

-- The check registry: run(pos) returns the reading shown and written.
local CHECKS = {
    smart = function()
        local smart, dist = _get_nearest_smart()
        if not smart then return "none" end
        local props = (xsmart.is_base(smart) and "  base" or "") .. (xsmart.is_lair(smart) and "  lair" or "")
        return string_format("%s %.0f m%s", smart:name(), dist or -1, props)
    end,
    base_owner = function(pos)
        local owner, dist = xsmart.find_base_owner(pos, BASE_OWNER_RADIUS)
        if not owner then return string_format("none within %d m", BASE_OWNER_RADIUS) end
        return string_format("%s %.0f m", owner, dist)
    end,
    is_indoor = function(pos)
        return _get_place_word(xcombat.is_indoor(pos) == true)
    end,
    roof_walls = function(pos)
        local enc = xcombat.get_enclosure(pos)
        if not enc then return "n/a" end
        local near = 0
        for i = 1, 4 do near = near + ((enc.walls[i] and enc.walls[i] <= WALL_NEAR) and 1 or 0) end
        local roof = enc.roof and string_format("roof %.1f m", enc.roof) or "no roof"
        return string_format("%s  walls %d within %d m", roof, near, WALL_NEAR)
    end,
    roof = function(pos)
        local height, via = _get_roof_height(pos)
        if not height then return "open sky = outdoor" end
        return string_format("roof %.1f m (%s) = %s", height, via, _get_place_word(height <= ROOF_NEAR))
    end,
    sky = function()
        local value = db.actor:get_luminocity_hemi()
        return string_format("%.3f = %s", value, _get_place_word(value < SKY_INDOOR_BELOW))
    end,
    underground = function()
        return _get_yes_no(GetEvent("underground") == true)
    end,
    surge_cover = function(pos)
        local sm = surge_manager.get_surge_manager()
        return _get_yes_no(sm and sm:pos_in_cover(pos))
    end,
    safe_cover = function()
        return _get_yes_no(GetEvent("current_safe_cover"))
    end,
    rain = function()
        return level.rain_hemi and string_format("%.2f", level.rain_hemi()) or "n/a"
    end,
}

-- Run every check at pos into _readings, in CHECK_ORDER.
local function _update_readings(pos)
    local rows = {}
    for i = 1, #CHECK_ORDER do
        rows[i] = { name = CHECK_ORDER[i], reading = tostring(CHECKS[CHECK_ORDER[i]](pos)) }
    end
    _readings = rows
end

local function _format_readings()
    local parts = {}
    for i = 1, #_readings do parts[#parts + 1] = _readings[i].name .. "=" .. _readings[i].reading end
    return table_concat(parts, "; ")
end

local function _is_window_open()
    return _box ~= nil and _box:IsShown()
end

-- One record in this game run's file: the level, the kind, x y z, the level vertex, the payload.
local function _write_record(kind, payload)
    local actor = db.actor
    if not actor then return false end
    local pos = actor:position()
    local is_written = tz_ui.write_line(OUTPUT_TOOL, level.name(), kind, string_format("%.2f %.2f %.2f", pos.x, pos.y, pos.z),
        actor:level_vertex_id(), payload)
    if not is_written then return false end
    xcui.push_line(_feed, string_format("%s %s %s", os_date("%H:%M:%S"), kind, payload or ""), FEED_MAX, FEED_CHARS)
    if _is_window_open() then _box:render() end
    return true
end

--- One live tick for the open window; it re-arms first and stops once the window closes.
--- Time events keep running while a dialog is open (tz_anim.script:205, tested with its window open).
local function _update_live()
    if not _is_window_open() then _live_on = false; return true end
    ResetTimeEvent(EV, "live", _get_setting("refresh"))
    if not db.actor then return false end
    _update_readings(db.actor:position())
    _box:render()
    return false
end

local function _start_live()
    if _live_on then return end
    _live_on = true
    CreateTimeEvent(EV, "live", _get_setting("refresh"), _update_live)
end

--- One axis's digit statics, as tz_geo_tool.xml names them.
local function _get_digit_names(axis)
    local names = {}
    for d = 1, AXIS_DIGITS do names[d] = string_format("digit_%d_%d", axis, d) end
    return names
end

--- Open the window with the refresh already started, so its first render shows the green lamp; the first tick comes a refresh period later.
local function _try_open()
    if Check_UI() or not db.actor then return end
    _start_live()
    _box = tz_geo_tool_wnd()
    _box:ShowDialog(true)
    Register_UI("tz_geo_tool_wnd", "tz_geo_tool", _box)
end

local function _on_key_press(key)
    if key == _get_setting("key") then _try_open() end
end

--- A level change with the window open: stop the refresh and drop the open-window entry before the Lua state is rebuilt.
local function _on_actor_destroy()
    RemoveTimeEvent(EV, "live")
    _live_on = false
    Unregister_UI("tz_geo_tool_wnd")
end

class "tz_geo_tool_wnd" (CUIScriptWnd)

function tz_geo_tool_wnd:__init() super()
    self:SetWndRect(Frect():set(0, 0, 1024, 768))
    self:SetAutoDelete(true)
    self:init_controls()
    self:init_callbacks()
    _update_readings(db.actor:position())
    self:render()
end

--- The window's controls in draw order.
function tz_geo_tool_wnd:get_layout()
    local digits = {}
    for axis = 1, AXES do
        digits[#digits + 1] = string_format("digit_%d_sign", axis)
        for _, name in ipairs(_get_digit_names(axis)) do digits[#digits + 1] = name end
    end
    return {
        { kind = "static", names = tz_ui.PANEL },
        { kind = "static", names = DECOR.statics },
        { kind = "text", names = { "lbl_where" } },
        { kind = "static", names = digits },
        { kind = "text", names = xcui.get_names("reading_name_", #CHECK_ORDER) },
        { kind = "text", names = xcui.get_names("reading_value_", #CHECK_ORDER) },
        { kind = "static", names = { "lamp_green", "lamp_red" } },
        { kind = "text", names = { "note_tint" } },
        { kind = "edit", names = { "note" } },
        { kind = "button", names = { "btn_note", "btn_help" } },
        { kind = "text", names = xcui.get_names("feed_row_", FEED_MAX) },
    }
end

function tz_geo_tool_wnd:init_controls()
    local xml = CScriptXmlInit()
    xml:ParseFile("tz_geo_tool.xml")
    local ui = xcui.build(xml, self, self:get_layout())
    self.ui = ui
    self.lbl_where, self.note = ui.lbl_where, ui.note
    ui.note_tint:SetText(" ")
    self.reading_names = xcui.get_controls(ui, xcui.get_names("reading_name_", #CHECK_ORDER))
    self.reading_values = xcui.get_controls(ui, xcui.get_names("reading_value_", #CHECK_ORDER))
    self.feed_rows = xcui.get_controls(ui, xcui.get_names("feed_row_", FEED_MAX))
    self.signs, self.digits = {}, {}
    for axis = 1, AXES do
        self.signs[axis] = ui[string_format("digit_%d_sign", axis)]
        self.digits[axis] = xcui.get_controls(ui, _get_digit_names(axis))
    end
end

function tz_geo_tool_wnd:init_callbacks()
    self:AddCallback("btn_note", ui_events.BUTTON_CLICKED, self.add_note, self)
    self:AddCallback("btn_help", ui_events.BUTTON_CLICKED, self.show_help, self)
end

function tz_geo_tool_wnd:show_help()
    tz_help.show_page("tz_geo_tool.xml", "st_tz_geo_tool_help_title", "st_tz_geo_tool_help")
end

function tz_geo_tool_wnd:add_note()
    add_note(self.note:GetText())
    self.note:SetText("")
end

--- One axis in the dosimeter's digits: the whole metres, zero-padded to four, the sign shown only below zero.
function tz_geo_tool_wnd:render_axis(axis, value)
    local whole = math_floor(math_abs(value) + 0.5)
    if whole > AXIS_MAX then whole = AXIS_MAX end
    local text = string_format("%04d", whole)
    self.signs[axis]:Show(value < -0.5)
    for d = 1, AXIS_DIGITS do self.digits[axis][d]:InitTexture("tz_digit_" .. text:sub(d, d)) end
end

--- Position, readings and last lines; the green lamp shows the readings refreshing, which they do while the window is open.
function tz_geo_tool_wnd:render()
    local actor = db.actor
    if actor then
        local pos = actor:position()
        self.lbl_where:SetText(string_format("%s    v%d", level.name(), actor:level_vertex_id()))
        self:render_axis(1, pos.x)
        self:render_axis(2, pos.y)
        self:render_axis(3, pos.z)
    end
    for i = 1, #CHECK_ORDER do
        local data = _readings[i]
        self.reading_names[i]:SetText(CHECK_ORDER[i])
        self.reading_values[i]:SetText(data and data.reading or "")
    end
    xcui.set_lines(self.feed_rows, _feed)
    tz_ui.render_lamps(self.ui, _live_on)
end

--- Esc closes the window when no edit box has focus, so typing a note never closes it.
function tz_geo_tool_wnd:OnKeyboard(dik, action)
    local res = CUIScriptWnd.OnKeyboard(self, dik, action)
    if not xcui.is_close_key(res, dik, action) then return res end
    self:hide()
    return true
end

function tz_geo_tool_wnd:hide()
    self:HideDialog()
    Unregister_UI("tz_geo_tool_wnd")
end

--- Write one NOTE record with every check's reading at the actor's spot, led by the typed text when there is one.
--- @param text string|nil The note text; empty or nil saves the spot alone
function add_note(text)
    if not db.actor then return end
    _update_readings(db.actor:position())
    local readings = _format_readings()
    _write_record("NOTE", (text and text ~= "") and ("note=" .. text .. "; " .. readings) or readings)
end

function on_game_start()
    RegisterScriptCallback("on_key_press", _on_key_press)
    RegisterScriptCallback("actor_on_net_destroy", _on_actor_destroy)
end
