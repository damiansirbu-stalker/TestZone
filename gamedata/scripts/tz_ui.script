--- tz_ui: the parts every TestZone tool window shares, built on the xlibs xcui primitives.

local os_date, os_time, os_clock, math_abs, math_floor = os.date, os.time, os.clock, math.abs, math.floor
local string_format, table_concat, table_sort, tonumber, tostring, select = string.format, table.concat, table.sort, tonumber, tostring, select

--- The bevelled body every tool window sits on, in draw order: the outer line, the opaque panel, the light top-left and dark bottom-right edges.
PANEL = { "panel_outer", "panel_body", "panel_light_t", "panel_light_l", "panel_shade_b", "panel_shade_r" }

-- Lamp tints as r, g, b, a: a lit lamp shows its texture as drawn; the unlit one stays opaque at about a third of its brightness.
local LAMP_LIT, LAMP_DIM = { 255, 255, 255, 255 }, { 90, 90, 90, 255 }
-- Seconds two Lua states of one game run can disagree on its launch time: os.time counts whole seconds.
local LAUNCH_SLACK = 2
-- Each tool's file for this game run once found or named, by tool.
local _paths = {}

--- The launch time a session file name carries, as sound_tool_20261122_162100.txt, else nil.
local function _get_launch(name, tool)
    local y, mo, d, h, mi, s = name:match("^" .. tool .. "_(%d%d%d%d)(%d%d)(%d%d)_(%d%d)(%d%d)(%d%d)%.txt$")
    if not y then return nil end
    return os_time({ year = tonumber(y), month = tonumber(mo), day = tonumber(d), hour = tonumber(h), min = tonumber(mi), sec = tonumber(s) })
end

--- Light the green lamp while the tool runs something and the red one when it stops; the unlit lamp is dimmed.
--- @param controls table The window's controls from xcui.build, holding lamp_green and lamp_red
--- @param is_on boolean True while the tool runs something
function render_lamps(controls, is_on)
    local lit = xcui.get_color(LAMP_LIT[1], LAMP_LIT[2], LAMP_LIT[3], LAMP_LIT[4])
    local dim = xcui.get_color(LAMP_DIM[1], LAMP_DIM[2], LAMP_DIM[3], LAMP_DIM[4])
    controls.lamp_green:SetTextureColor(is_on and lit or dim)
    controls.lamp_red:SetTextureColor(is_on and dim or lit)
end

--- The game's logs folder in xfs.format_dir form, where every tool writes and every disk browser opens.
--- @return string The absolute folder, ending in a backslash
function get_logs_dir()
    return xfs.format_dir(xfs.resolve_path("$logs$", ""))
end

--- The rows of a disk browser at dir: "..", the subfolders, then the files with one of the extensions, each group by name; dir "" lists the drives.
--- A row is { label, dir } for a folder or { label, path } for a file. The drive list's ".." row carries neither, and leads back to the tool's root.
--- @param dir string An absolute folder in xfs.format_dir form, or "" for the drive list
--- @param exts table The file extensions listed, lowercase and without the dot, as { "txt" }
--- @return table The rows
--- @return table Every file name in the folder, sorted, for a tool that counts kinds of its own
function get_browse_rows(dir, exts)
    if dir == "" then
        local rows, drives = { { label = ".." } }, xfs.read_drives()
        for i = 1, #drives do rows[#rows + 1] = { label = drives[i] .. "\\", dir = drives[i] .. "\\" } end
        return rows, {}
    end
    local rows = { { label = "..", dir = xfs.get_parent_dir(dir) } }
    local folders, files = xfs.read_disk_entries(dir:sub(1, -2))
    table_sort(folders)
    table_sort(files)
    local is_listed = {}
    for i = 1, #exts do is_listed[exts[i]] = true end
    for i = 1, #folders do
        local sub = dir .. folders[i] .. "\\"
        rows[#rows + 1] = { label = folders[i] .. "\\", dir = sub }
    end
    for i = 1, #files do
        if is_listed[(files[i]:match("%.([^%.]+)$") or ""):lower()] then rows[#rows + 1] = { label = files[i], path = dir .. files[i] } end
    end
    return rows, files
end

--- The tool's file for this game run, named by the launch time os.time() - os.clock(), since os.clock counts from process start (luajit lib_os.c:122-126).
--- A level change rebuilds the Lua state (xray alife_simulator.cpp:28-37 restart_all), so the file is found again by its launch time.
--- @param tool string The file prefix, as sound_tool
--- @return string The absolute path
function get_session_path(tool)
    if _paths[tool] then return _paths[tool] end
    local dir = get_logs_dir()
    local launch = os_time() - os_clock()
    local _, files = xfs.read_disk_entries(dir:sub(1, -2))
    local name
    for i = 1, #files do
        local found = _get_launch(files[i], tool)
        if found and math_abs(found - launch) <= LAUNCH_SLACK then name = files[i] end
    end
    name = name or string_format("%s_%s.txt", tool, os_date("%Y%m%d_%H%M%S", math_floor(launch + 0.5)))
    _paths[tool] = dir .. name
    return _paths[tool]
end

--- Append one tab-separated line to the tool's file for this game run: the time, then the fields, a nil field kept as an empty column.
--- @param tool string The file prefix
--- @param ... any Source, what was pressed, the item, the tool's own details, the note last
--- @return boolean True when the line was written
function write_line(tool, ...)
    local clean = {}
    for i = 1, select("#", ...) do clean[i] = tostring(select(i, ...) or ""):gsub("[\t\r\n]", " ") end
    return xfs.write_file(get_session_path(tool), os_date("%Y-%m-%d %H:%M:%S") .. "\t" .. table_concat(clean, "\t") .. "\n", true)
end
