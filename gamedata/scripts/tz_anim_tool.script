--- tz_anim_tool: the animation review remote. Forces each dig candidate on the aimed NPC and logs a verdict. Dev-only, opens on the MCM anim_key.

local table_sort, string_format, table_concat = table.sort, string.format, table.concat
local os_date = os.date
local tostring, IsStalker = tostring, IsStalker
local RegisterScriptCallback = RegisterScriptCallback

local CONFIG_MOUNT  = "$game_config$"
local ANIM_DIR      = "testzone\\anim\\"
-- The prefix of this tool's file per game run in the logs folder (tz_ui.write_line).
local OUTPUT_TOOL   = "animation_tool"
local VIEW_ROOT, VIEW_POOL, VIEW_PROP = "root", "pool", "prop"
local FILL_QUEUE, FILL_STEP = "tz_anim_fill", 20
-- While the window is open the display refreshes this often, in seconds, so the NPC's states stay current.
local LIVE_EV, LIVE_PERIOD = "tz_anim_tool", 0.5
-- The most characters of each state name on the display's second line.
local STATE_CHARS = 13
-- Posture key labels: the layout's key color, brighter on the lit toggle.
local LABEL_RGB, LABEL_LIT_RGB = { 175, 180, 190 }, { 235, 240, 245 }

-- Attachable props the engine spawns + attaches via the `{a=section}` hook (state_mgr_animation.script:480-495); the only blade is anim_knife, no firearms.
local PROPS = {
    { section = "vodka",              group = "booze" },
    { section = "beer",               group = "booze" },
    { section = "energy_drink",       group = "booze" },
    { section = "mineral_water",      group = "booze" },
    { section = "bread",              group = "food" },
    { section = "kolbasa",            group = "food" },
    { section = "stick_kolbasa",      group = "roast" },
    { section = "stick_bred",         group = "roast" },
    { section = "stick_kolbasa_bred", group = "roast" },
    { section = "guitar_a",           group = "instrument" },
    { section = "harmonica_a",        group = "instrument" },
    { section = "hand_radio",         group = "device" },
    { section = "detector_advanced",  group = "device" },
    { section = "anomaly_scaner",     group = "device" },
    { section = "pda_for_nps",        group = "device" },
    { section = "anim_binoc",         group = "device" },
    { section = "medkit_script",      group = "device" },
    { section = "sigaret_for_nps",    group = "smoke" },
    { section = "anim_knife",         group = "blade" },
}

-- The last-lines screen: the newest verdicts written, clipped to the row width.
local FEED_MAX, FEED_CHARS = 2, 30
-- Decor the window draws and never touches again: the panel frame, the screens' rim and glass, the lines and the verdict box.
local DECOR = { statics = { "hdr_tool", "scr_display_rim", "scr_display_glass", "scr_list_rim", "scr_list_glass", "list_line",
    "verdict_box_t", "verdict_box_b", "verdict_box_l", "verdict_box_r", "scr_sel_rim", "scr_sel_glass", "scr_snote_rim", "scr_snote_glass",
    "note_plus_h", "note_plus_v", "scr_feed_rim", "scr_feed_glass" } }

local COL_MOTION, COL_STATE, COL_NAME = "motion", "state", "name"
local COL_CATEGORY, COL_VERDICT = "category", "verdict"

-- Posture for the next play, one toggle each; a state item ignores it. The prop is a separate selection (_prop).
local MODES = {
    { label = "pose",   moving = false, key = "btn_pose",   lit = "lit_pose" },
    { label = "moving", moving = true,  key = "btn_moving", lit = "lit_moving" },
}

local _view    = VIEW_ROOT
local _playlists = {}
local _row     = nil
local _cur     = nil
local _mode_i  = 1
-- The attached prop section for the next play, nil = none; an independent selection that persists across motions.
local _prop    = nil
local _npc_id  = nil
local _npc_name = nil
-- The standing selection: an NPC pinned via the Select button that persists across opens, so the tool binds and shows it until you re-select.
local _selected_id   = nil
-- RemoveAll on the empty, not-yet-attached list (the first fill) CTDs in CUIScrollView::Clear.
local _built   = false
local _feed    = {}
-- True while a motion is held on the NPC, for the lamps.
local _is_holding = false
-- The list's selected row and scroll when the window last closed, put back on the next open.
local _place = nil

local function _get_mode() return MODES[_mode_i] end

-- Split a TSV line on tabs, preserving empty fields so columns stay aligned.
local function _split_tab(line)
    local out = {}
    for field in (line .. "\t"):gmatch("(.-)\t") do out[#out + 1] = field end
    return out
end

-- Find every playlist (.tsv or .txt) shipped or dropped in configs\testzone\anim.
local function _find_playlists()
    local out = {}
    local exts = { ".tsv", ".txt" }
    for e = 1, #exts do
        local found = xfs.read_files(CONFIG_MOUNT, ANIM_DIR, exts[e])
        for i = 1, #found do out[#out + 1] = found[i] .. exts[e] end
    end
    table_sort(out)
    return out
end

-- Read one playlist into a candidate pool, auto-detecting a TSV header or a plain one-name-per-line txt; a ; line is a comment.
-- A TSV with a "state" column holds states (held directly); anything else is motions (a temp state is built).
local function _read_playlist(file)
    local data = xfs.read_file(getFS():update_path(CONFIG_MOUNT, "") .. ANIM_DIR .. file)
    if not data then return nil end
    local lines = {}
    for line in data:gmatch("[^\r\n]+") do lines[#lines + 1] = line end
    local header = lines[1] and _split_tab(lines[1]) or {}
    local is_tsv = #header > 1
    local name_i, cat_i, verdict_i, is_state = 1, nil, nil, false
    if is_tsv then
        for i = 1, #header do
            local col = header[i]
            if col == COL_MOTION or col == COL_STATE or col == COL_NAME then name_i = i end
            if col == COL_STATE then is_state = true end
            if col == COL_CATEGORY then cat_i = i end
            if col == COL_VERDICT then verdict_i = i end
        end
    end
    local pool = {}
    for k = (is_tsv and 2 or 1), #lines do
        local name, label
        if is_tsv then
            local cols = _split_tab(lines[k])
            name = cols[name_i]
            local extra = {}
            if cat_i and cols[cat_i] and cols[cat_i] ~= "" then extra[#extra + 1] = cols[cat_i] end
            if verdict_i and cols[verdict_i] and cols[verdict_i] ~= "" then extra[#extra + 1] = cols[verdict_i] end
            label = name and (#extra > 0 and string_format("%s  [%s]", name, table_concat(extra, " ")) or name)
        else
            name = lines[k]:match("^%s*(.-)%s*$")
            if name == "" or name:sub(1, 1) == ";" then name = nil end
            label = name
        end
        if name and name ~= "" then pool[#pool + 1] = { name = name, is_state = is_state, label = label } end
    end
    return { label = file, pool = pool }
end

--- One verdict line in this game run's file: the playlist, the verdict, the motion, the posture, the note.
local function _write_verdict(name, verdict, note)
    return tz_ui.write_line(OUTPUT_TOOL, _row and _row.label, verdict, name, _get_mode().label, note)
end

--- Put one written verdict at the top of the FILE feed, clipped so it fits its row.
local function _add_feed_line(name, verdict)
    local short = string_format("%s  %s = %s", os_date("%H:%M:%S"), name, verdict)
    xcui.push_line(_feed, short, FEED_MAX, FEED_CHARS)
end

--- The standing-selected stalker's object when it is still a live online stalker, else nil (a despawn or death drops the selection on read).
local function _get_selected_npc()
    if not _selected_id then return nil end
    local st = db.storage[_selected_id]
    local npc = st and st.object
    if npc and npc:alive() and IsStalker(npc) then return npc end
    return nil
end

--- The state last asked of the NPC, then after the > the animation playing now; the asked one stays after its motion ends (state_mgr.script:436-438).
local function _format_states(npc)
    local st = npc and npc:alive() and db.storage[npc:id()]
    local mgr = st and st.state_mgr
    if not mgr then return "?" end
    local playing = mgr.animation and mgr.animation.states and mgr.animation.states.current_state
    return string_format("%s > %s", xcui.get_clipped(tostring(state_mgr.get_state(npc)), STATE_CHARS),
        xcui.get_clipped(tostring(playing or "none"), STATE_CHARS))
end

--- The stalker directly under the view-ray, else nil when the ray hits a wall, a fence or no stalker.
local function _get_aimed_stalker()
    local tgt = level.get_target_obj and level.get_target_obj() or nil
    return (tgt and IsStalker(tgt)) and tgt or nil
end

--- Bind the standing selection when one is live, else the aimed stalker.
local function _try_open()
    if Check_UI() or not db.actor then return end
    local tgt = _get_selected_npc() or _get_aimed_stalker()
    if tgt then _npc_id, _npc_name = tgt:id(), tgt:character_name()
    else _npc_id, _npc_name = nil, nil end
    local window = tz_anim_tool_wnd()
    window:ShowDialog(true)
    Register_UI("tz_anim_tool_wnd", "tz_anim_tool", window)
end

local function _on_key_press(key)
    if key == tz_mcm.get_config("anim_key") then _try_open() end
end

--- A level change with the window open: drop the fill, the held motion and the open-window entry before the Lua state is rebuilt.
local function _on_actor_destroy()
    xslice.stop_queue(FILL_QUEUE, true)
    RemoveTimeEvent(LIVE_EV, "live")
    tz_anim.stop_review_hold()
    _is_holding = false
    Unregister_UI("tz_anim_tool_wnd")
end

class "tz_anim_tool_wnd" (CUIScriptWnd)

function tz_anim_tool_wnd:__init() super()
    self:SetWndRect(Frect():set(0, 0, 1024, 768))
    self:SetAutoDelete(true)
    self:init_controls()
    self:init_callbacks()
    _built = false
    self:build_list(_place)
    self:render()
    self:start_live_watch()
end

--- Re-arm a short timer that redraws the display while the window is open, so the NPC's states stay current.
function tz_anim_tool_wnd:start_live_watch()
    CreateTimeEvent(LIVE_EV, "live", LIVE_PERIOD, function()
        if not self:IsShown() then return true end
        self:render()
        ResetTimeEvent(LIVE_EV, "live", LIVE_PERIOD)
        return false
    end)
end

--- The window's controls in draw order. Each posture diode comes after its key, so it draws on the key's plate.
function tz_anim_tool_wnd:get_layout()
    local spec = {
        { kind = "static", names = tz_ui.PANEL },
        { kind = "static", names = DECOR.statics },
        { kind = "text", names = xcui.get_names("feed_row_", FEED_MAX) },
        { kind = "list", names = { "list" } },
        { kind = "text", names = { "lbl_path", "lbl_now", "lbl_mode", "sel_line" } },
        { kind = "static", names = { "lamp_green", "lamp_red" } },
        { kind = "edit", names = { "snote" } },
        { kind = "button", names = { "btn_select", "btn_reset", "btn_prior", "btn_play", "btn_stop", "btn_next",
            "btn_good", "btn_bad", "btn_note", "btn_help" } },
        { kind = "static", names = { "lit_select" } },
    }
    for i = 1, #MODES do
        spec[#spec + 1] = { kind = "button", names = { MODES[i].key } }
        spec[#spec + 1] = { kind = "static", names = { MODES[i].lit } }
    end
    return spec
end

function tz_anim_tool_wnd:init_controls()
    local xml = CScriptXmlInit()
    xml:ParseFile("tz_anim_tool.xml")
    local ui = xcui.build(xml, self, self:get_layout())
    self.ui = ui
    self.list = ui.list
    self.list:ShowSelectedItem(true)
    self.lbl_path, self.lbl_now, self.lbl_mode, self.sel_line = ui.lbl_path, ui.lbl_now, ui.lbl_mode, ui.sel_line
    self.snote = ui.snote
    self.feed_rows = xcui.get_controls(ui, xcui.get_names("feed_row_", FEED_MAX))
    self.mode_keys, self.mode_lits = {}, {}
    for i = 1, #MODES do self.mode_keys[i], self.mode_lits[i] = ui[MODES[i].key], ui[MODES[i].lit] end
end

function tz_anim_tool_wnd:init_callbacks()
    self:AddCallback("list",         ui_events.LIST_ITEM_CLICKED, self.select_row,      self)
    self:AddCallback("list",         ui_events.WINDOW_LBUTTON_DB_CLICK, function() if _view == VIEW_POOL then self:_play_current() end end, self)
    self:AddCallback("btn_select",   ui_events.BUTTON_CLICKED,    self.select_npc,      self)
    self:AddCallback("btn_reset",    ui_events.BUTTON_CLICKED,    self.clear_selection, self)
    self:AddCallback("btn_pose",     ui_events.BUTTON_CLICKED, function() self:select_mode(1) end, self)
    self:AddCallback("btn_moving",   ui_events.BUTTON_CLICKED, function() self:select_mode(2) end, self)
    self:AddCallback("btn_prior",    ui_events.BUTTON_CLICKED,    self.select_prev_item, self)
    self:AddCallback("btn_play",     ui_events.BUTTON_CLICKED,    self.play,            self)
    self:AddCallback("btn_stop",     ui_events.BUTTON_CLICKED,    self.stop,            self)
    self:AddCallback("btn_next",     ui_events.BUTTON_CLICKED,    self.select_next_item, self)
    self:AddCallback("btn_good", ui_events.BUTTON_CLICKED, function() self:add_verdict("good") end, self)
    self:AddCallback("btn_bad",  ui_events.BUTTON_CLICKED, function() self:add_verdict("bad") end, self)
    self:AddCallback("btn_note", ui_events.BUTTON_CLICKED, function() self:add_verdict("note") end, self)
    self:AddCallback("btn_help", ui_events.BUTTON_CLICKED, self.show_help, self)
end

function tz_anim_tool_wnd:show_help()
    tz_help.show_page("tz_anim_tool.xml", "st_tz_anim_tool_help_title", "st_tz_anim_tool_help")
end

--- Fill the list for the current view; with a place, put the list back there once the rows are in.
function tz_anim_tool_wnd:build_list(place)
    xslice.stop_queue(FILL_QUEUE, true)
    if _built then self.list:RemoveAll() end
    _built = true
    local on_filled = place and function() xcui.set_list_place(self.list, place) end
    if _view == VIEW_POOL then return self:add_pool_rows(_row, on_filled) end
    if _view == VIEW_ROOT then self:add_playlist_rows() else self:add_prop_rows() end
    if on_filled then on_filled() end
end

--- Fill the root list with the playlists in the anim folder, or a hint when none are present.
function tz_anim_tool_wnd:add_playlist_rows()
    _playlists = _find_playlists()
    if #_playlists == 0 then
        self.list:AddTextItem("(empty - drop a .tsv or .txt in configs\\testzone\\anim)")
        return
    end
    for i = 1, #_playlists do self.list:AddTextItem(_playlists[i]) end
end

--- Fill the prop picker: back, a clear entry, then every attachable prop labelled by its group.
function tz_anim_tool_wnd:add_prop_rows()
    self.list:AddTextItem("..")
    self.list:AddTextItem("(none)")
    for i = 1, #PROPS do
        self.list:AddTextItem(string_format("%s  (%s)", PROPS[i].section, PROPS[i].group))
    end
end

--- Fill one playlist's pool, frame-spread by xslice so a large motion list never builds in one frame; on_filled runs once every row is in.
function tz_anim_tool_wnd:add_pool_rows(row, on_filled)
    if not row then return end
    self.list:AddTextItem("..")
    self.list:AddTextItem(string_format("[ prop:  %s ]", _prop or "none"))
    local list = self.list
    xslice.start(FILL_QUEUE, row.pool, { step = FILL_STEP, on_done = on_filled, func = function(entry)
        list:AddTextItem(entry.label)
        return true
    end })
end

--- Green while a motion is held on the NPC, red once it stops; the unlit lamp is faded.
function tz_anim_tool_wnd:render_lamps()
    tz_ui.render_lamps(self.ui, _is_holding)
end

--- Light the posture toggle in use: its diode on and its label bright.
function tz_anim_tool_wnd:render_modes()
    for i = 1, #MODES do
        local is_on = i == _mode_i
        self.mode_lits[i]:Show(is_on)
        local rgb = is_on and LABEL_LIT_RGB or LABEL_RGB
        self.mode_keys[i]:TextControl():SetTextColor(xcui.get_color(rgb[1], rgb[2], rgb[3], 255))
    end
end

--- The list's first line: the playlist folder, the prop picker, or the open playlist and its row count.
function tz_anim_tool_wnd:render_path()
    if _view == VIEW_ROOT then
        self.lbl_path:SetText("configs\\testzone\\anim")
    elseif _view == VIEW_PROP then
        self.lbl_path:SetText("props")
    else
        self.lbl_path:SetText(string_format("%s    (%d)", _row and _row.label or "?", _row and #_row.pool or 0))
    end
end

function tz_anim_tool_wnd:render()
    xcui.set_lines(self.feed_rows, _feed)
    self:render_lamps()
    self:render_modes()
    self:render_path()
    self.ui.lit_select:Show(_selected_id ~= nil and _npc_id == _selected_id)
    self.sel_line:SetText(_cur and string_format("%s   %s", _cur.name, _cur.is_state and "state" or "motion") or "")
    if _npc_id then
        self.lbl_now:SetText(xcui.get_clipped(tostring(_npc_name), 24))
        self.lbl_mode:SetText(_format_states(db.storage[_npc_id] and db.storage[_npc_id].object))
    else
        self.lbl_now:SetText("** NO NPC **")
        self.lbl_mode:SetText("look at a stalker, reopen the tool")
    end
end

--- Pin the aimed stalker, else the bound one, as the standing selection, so he stays bound across close and reopen; the select key's diode lights.
function tz_anim_tool_wnd:select_npc()
    local tgt = _get_aimed_stalker()
    if tgt then _npc_id, _npc_name = tgt:id(), tgt:character_name() end
    if not _npc_id then return end
    _selected_id = _npc_id
    self:render()
end

--- Drop the standing selection and the current binding; the band falls back to NO NPC until the next open.
function tz_anim_tool_wnd:clear_selection()
    _selected_id = nil
    _npc_id, _npc_name = nil, nil
    self:render()
end

function tz_anim_tool_wnd:_play_current()
    if not (_cur and _npc_id) then return end
    local mode = _get_mode()
    local item = { name = _cur.name, is_state = _cur.is_state, moving = mode.moving, prop = _prop }
    _is_holding = tz_anim.start_review_hold(_npc_id, item) ~= nil
    self:render_lamps()
end

function tz_anim_tool_wnd:select_row()
    local idx = self.list:GetSelectedIndex()
    if not idx or idx < 0 then return end
    if _view == VIEW_ROOT then
        self:select_root(idx)
    elseif _view == VIEW_PROP then
        self:select_prop(idx)
    else
        self:select_pool(idx)
    end
end

--- ROOT click: load the chosen playlist into a pool and switch to the candidate list.
function tz_anim_tool_wnd:select_root(idx)
    local file = _playlists[idx + 1]
    if not file then return end
    local row = _read_playlist(file)
    if not (row and #row.pool > 0) then return end
    _row, _view = row, VIEW_POOL
    self:build_list(); self:render()
end

--- POOL click: index 0 returns to the playlists, index 1 opens the prop picker, any other index selects that candidate; Play or a double click plays it.
function tz_anim_tool_wnd:select_pool(idx)
    if idx == 0 then
        _view, _cur = VIEW_ROOT, nil
        self:stop()
        self:build_list(); self:render()
        return
    end
    if idx == 1 then
        _view = VIEW_PROP
        self:build_list(); self:render()
        return
    end
    local entry = _row and _row.pool[idx - 1]
    if not entry then return end
    _cur = entry
    self:render()
end

--- PROP click: index 0 returns to the pool, index 1 clears the prop, any other index selects it.
--- The pick persists across motions and replays the current one so the change shows at once.
function tz_anim_tool_wnd:select_prop(idx)
    if idx == 0 then
        _view = VIEW_POOL
        self:build_list(); self:render()
        return
    end
    _prop = (idx == 1) and nil or (PROPS[idx - 1] and PROPS[idx - 1].section)
    _view = VIEW_POOL
    self:build_list(); self:render()
    if _cur then self:_play_current() end
end

function tz_anim_tool_wnd:play() self:_play_current() end

function tz_anim_tool_wnd:stop()
    tz_anim.stop_review_hold()
    _is_holding = false
    self:render_lamps()
end

--- A posture toggle: light it and replay the current item so the change is visible at once.
function tz_anim_tool_wnd:select_mode(index)
    _mode_i = index
    self:_play_current(); self:render()
end

--- The pool index of the loaded candidate, or 1 when none is loaded.
function tz_anim_tool_wnd:find_pool_index()
    if not (_cur and _row) then return 1 end
    for k = 1, #_row.pool do
        if _row.pool[k].name == _cur.name then return k end
    end
    return 1
end

--- Step to a neighbouring candidate and play it (curation steps through and sees each in turn).
function tz_anim_tool_wnd:_select_neighbor(delta)
    if _view ~= VIEW_POOL or not (_row and #_row.pool > 0) then return end
    local at = (self:find_pool_index() - 1 + delta) % #_row.pool + 1
    _cur = _row.pool[at]
    self.list:SetSelectedIndex(at + 1)
    self:_play_current()
    self:render()
end

function tz_anim_tool_wnd:select_prev_item() self:_select_neighbor(-1) end
function tz_anim_tool_wnd:select_next_item() self:_select_neighbor(1) end

--- Write a verdict line for the current candidate; the typed note combines with the verdict word.
--- Verdicts: good (keep), bad (cut), note (a free-text observation only).
function tz_anim_tool_wnd:add_verdict(verdict)
    if not _cur then return end
    local note = self.snote:GetText()
    local written = _write_verdict(_cur.name, verdict, note)
    self.snote:SetText("")
    if written then _add_feed_line(_cur.name, verdict) end
    self:render()
end

--- Esc closes the window when no edit box has focus, so game binds are never shadowed.
function tz_anim_tool_wnd:OnKeyboard(dik, action)
    local res = CUIScriptWnd.OnKeyboard(self, dik, action)
    if not xcui.is_close_key(res, dik, action) then return res end
    self:hide()
    return true
end

function tz_anim_tool_wnd:hide()
    _place = xcui.get_list_place(self.list)
    xslice.stop_queue(FILL_QUEUE, true)
    RemoveTimeEvent(LIVE_EV, "live")
    tz_anim.stop_review_hold()
    _is_holding = false
    self:HideDialog()
    Unregister_UI("tz_anim_tool_wnd")
end

function on_game_start()
    RegisterScriptCallback("on_key_press", _on_key_press)
    RegisterScriptCallback("actor_on_net_destroy", _on_actor_destroy)
end
