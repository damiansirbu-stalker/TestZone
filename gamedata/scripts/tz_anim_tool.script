--- tz_anim_tool: the animation review remote. Forces each dig candidate on the aimed NPC and logs a verdict. Dev-only, opens on HOME.

local table_sort, string_format, table_concat = table.sort, string.format, table.concat
local tostring, IsStalker = tostring, IsStalker
local RegisterScriptCallback = RegisterScriptCallback

local HOME_KEY      = 199
local LOGS_MOUNT    = "$logs$"
local CONFIG_MOUNT  = "$game_config$"
local ANIM_DIR      = "testzone\\anim\\"
local CURATION_FILE = "tz_anim_curation.txt"
local VIEW_ROOT, VIEW_POOL, VIEW_PROP = "root", "pool", "prop"

-- Attachable props the engine spawns + attaches via the `{a=section}` hook (state_mgr_animation.script:480-495); the only blade is anim_knife, no firearms.
local PROPS = {
    { section = "vodka",              group = "booze" },
    { section = "beer",               group = "booze" },
    { section = "energy_drink",       group = "booze" },
    { section = "mineral_water",      group = "booze" },
    { section = "bread",              group = "food" },
    { section = "kolbasa",            group = "food" },
    { section = "stick_kolbasa",      group = "roast" },
    { section = "stick_bred",         group = "roast" },
    { section = "stick_kolbasa_bred", group = "roast" },
    { section = "guitar_a",           group = "instrument" },
    { section = "harmonica_a",        group = "instrument" },
    { section = "hand_radio",         group = "device" },
    { section = "detector_advanced",  group = "device" },
    { section = "anomaly_scaner",     group = "device" },
    { section = "pda_for_nps",        group = "device" },
    { section = "anim_binoc",         group = "device" },
    { section = "medkit_script",      group = "device" },
    { section = "sigaret_for_nps",    group = "smoke" },
    { section = "anim_knife",         group = "blade" },
}

local COL_MOTION, COL_STATE, COL_NAME = "motion", "state", "name"
local COL_CATEGORY, COL_VERDICT = "category", "verdict"

-- Posture for the next play; a state item ignores it. The prop is a separate selection (_prop).
local MODES = {
    { label = "pose",   moving = false },
    { label = "moving", moving = true },
}

local _view    = VIEW_ROOT
local _sources = {}
local _row     = nil
local _cur     = nil
local _mode_i  = 1
-- The attached prop section for the next play, nil = none; an independent selection that persists across motions.
local _prop    = nil
local _npc_id  = nil
local _npc_name = nil
-- The standing selection: an NPC pinned via the Select button that persists across opens, so the tool binds and shows it until you re-select.
local _selected_id   = nil
local _box     = nil
-- RemoveAll on the empty, not-yet-attached list (the first fill) CTDs in CUIScrollView::Clear.
local _built   = false

local function _get_mode() return MODES[_mode_i] end

-- Shorten a long name with a trailing ~ so the fixed-width header never runs off the panel.
local function _get_clipped(s, n) return #s > n and (s:sub(1, n - 1) .. "~") or s end

-- Split a TSV line on tabs, preserving empty fields so columns stay aligned.
local function _split_tab(line)
    local out = {}
    for field in (line .. "\t"):gmatch("(.-)\t") do out[#out + 1] = field end
    return out
end

-- Find every source file (.tsv or .txt) shipped or dropped in configs\testzone\anim.
local function _find_sources()
    local out = {}
    local exts = { ".tsv", ".txt" }
    for e = 1, #exts do
        local found = (xfs and xfs.read_files and xfs.read_files(CONFIG_MOUNT, ANIM_DIR, exts[e])) or {}
        for i = 1, #found do out[#out + 1] = found[i] .. exts[e] end
    end
    table_sort(out)
    return out
end

-- Read one source file into a candidate pool, auto-detecting a TSV header or a plain one-name-per-line txt.
-- A TSV with a "state" column holds states (held directly); anything else is motions (a temp state is built).
local function _read_source(file)
    local base = getFS and getFS():update_path(CONFIG_MOUNT, "")
    if not base then return nil end
    local data = xfs and xfs.read_file and xfs.read_file(base .. ANIM_DIR .. file)
    if not data then return nil end
    local lines = {}
    for line in data:gmatch("[^\r\n]+") do lines[#lines + 1] = line end
    local header = lines[1] and _split_tab(lines[1]) or {}
    local is_tsv = #header > 1
    local name_i, cat_i, verdict_i, is_state = 1, nil, nil, false
    if is_tsv then
        for i = 1, #header do
            local col = header[i]
            if col == COL_MOTION or col == COL_STATE or col == COL_NAME then name_i = i end
            if col == COL_STATE then is_state = true end
            if col == COL_CATEGORY then cat_i = i end
            if col == COL_VERDICT then verdict_i = i end
        end
    end
    local pool = {}
    for k = (is_tsv and 2 or 1), #lines do
        local name, label
        if is_tsv then
            local cols = _split_tab(lines[k])
            name = cols[name_i]
            local extra = {}
            if cat_i and cols[cat_i] and cols[cat_i] ~= "" then extra[#extra + 1] = cols[cat_i] end
            if verdict_i and cols[verdict_i] and cols[verdict_i] ~= "" then extra[#extra + 1] = cols[verdict_i] end
            label = name and (#extra > 0 and string_format("%s  [%s]", name, table_concat(extra, " ")) or name)
        else
            name = lines[k]:match("^%s*(.-)%s*$")
            if name == "" or name:sub(1, 1) == "#" then name = nil end
            label = name
        end
        if name and name ~= "" then pool[#pool + 1] = { name = name, is_state = is_state, label = label } end
    end
    table_sort(pool, function(left, right) return left.name < right.name end)
    return { label = file, pool = pool }
end

local function _write_verdict(name, verdict, note)
    local base = getFS and getFS():update_path(LOGS_MOUNT, "")
    if not base then return false end
    return xfs.write_file(base .. CURATION_FILE,
        string_format("%s\t%s\t%s\t%s\n", verdict, name, _get_mode().label, note or ""), true)
end

--- The standing-selected stalker's object when it is still a live online stalker, else nil (a despawn or death drops the selection on read).
local function _get_selected_npc()
    if not _selected_id then return nil end
    local st = db.storage[_selected_id]
    local npc = st and st.object
    if npc and npc:alive() and IsStalker(npc) then return npc end
    return nil
end

--- Bind the standing selection when one is live, else the stalker directly under the view-ray; nothing when the ray hits a wall, fence, or no stalker.
local function try_open()
    if _box and _box:IsShown() then return end
    if not db.actor then return end
    local tgt = _get_selected_npc()
    if not tgt then
        tgt = level.get_target_obj and level.get_target_obj() or nil
        if not (tgt and IsStalker(tgt)) then tgt = nil end
    end
    if tgt then _npc_id, _npc_name = tgt:id(), tgt:name()
    else _npc_id, _npc_name = nil, nil end
    _box = tz_anim_tool_wnd()
    _box:ShowDialog(true)
    Register_UI("tz_anim_tool_wnd", "tz_anim_tool", _box)
end

class "tz_anim_tool_wnd" (CUIScriptWnd)

function tz_anim_tool_wnd:__init() super()
    self:SetWndRect(Frect():set(0, 0, 1024, 768))
    self:SetAutoDelete(true)
    self:init_controls()
    self:init_callbacks()
    _built = false
    _view, _row, _cur = VIEW_ROOT, nil, nil
    self:build_list()
    self:render()
end

function tz_anim_tool_wnd:init_controls()
    local xml = CScriptXmlInit()
    xml:ParseFile("tz_anim_tool.xml")
    xml:InitStatic("background", self)
    xml:InitStatic("hdr_player", self)
    xml:InitStatic("line_player", self)
    xml:InitStatic("screen", self)
    xml:InitStatic("hdr_verdict", self)
    xml:InitStatic("hdr_snote", self)
    xml:InitFrame("list_frame", self)
    self.list = xml:InitListBox("list", self)
    self.list:ShowSelectedItem(true)
    self:Register(self.list, "list")
    self.lbl_path = xml:InitStatic("lbl_path", self):TextControl()
    self.lbl_now  = xml:InitStatic("lbl_now", self):TextControl()
    self.lbl_mode = xml:InitStatic("lbl_mode", self):TextControl()
    self.status   = xml:InitStatic("status", self):TextControl()
    self.snote = xml:InitEditBox("snote", self)
    self:Register(self.snote, "snote")
    local buttons = { "btn_select", "btn_reset", "btn_pos_down", "btn_pos_up", "btn_prior", "btn_play", "btn_stop", "btn_next",
                      "btn_good", "btn_bad", "btn_note" }
    for i = 1, #buttons do self:Register(xml:Init3tButton(buttons[i], self), buttons[i]) end
end

function tz_anim_tool_wnd:init_callbacks()
    self:AddCallback("list",         ui_events.LIST_ITEM_CLICKED, self.select_row,      self)
    self:AddCallback("list",         ui_events.WINDOW_LBUTTON_DB_CLICK, function() if _view == VIEW_POOL then self:_play_current() end end, self)
    self:AddCallback("btn_select",   ui_events.BUTTON_CLICKED,    self.select_npc,      self)
    self:AddCallback("btn_reset",    ui_events.BUTTON_CLICKED,    self.clear_selection, self)
    self:AddCallback("btn_pos_down", ui_events.BUTTON_CLICKED,    self.select_prev_mode, self)
    self:AddCallback("btn_pos_up",   ui_events.BUTTON_CLICKED,    self.select_next_mode, self)
    self:AddCallback("btn_prior",    ui_events.BUTTON_CLICKED,    self.select_prev_item, self)
    self:AddCallback("btn_play",     ui_events.BUTTON_CLICKED,    self.play,            self)
    self:AddCallback("btn_stop",     ui_events.BUTTON_CLICKED,    self.stop,            self)
    self:AddCallback("btn_next",     ui_events.BUTTON_CLICKED,    self.select_next_item, self)
    self:AddCallback("btn_good", ui_events.BUTTON_CLICKED, function() self:add_verdict("good") end, self)
    self:AddCallback("btn_bad",  ui_events.BUTTON_CLICKED, function() self:add_verdict("bad") end, self)
    self:AddCallback("btn_note", ui_events.BUTTON_CLICKED, function() self:add_verdict("note") end, self)
end

function tz_anim_tool_wnd:build_list()
    if xslice then xslice.stop_queue("tz_anim_fill") end
    if _built then self.list:RemoveAll() end
    _built = true
    if _view == VIEW_ROOT then
        self:add_source_rows()
    elseif _view == VIEW_PROP then
        self:add_prop_rows()
    else
        self:add_pool_rows(_row)
    end
end

--- Fill the root list with the source files in the anim folder, or a hint when none are present.
function tz_anim_tool_wnd:add_source_rows()
    _sources = _find_sources()
    if #_sources == 0 then
        self.list:AddTextItem("(empty - drop a .tsv or .txt in configs\\testzone\\anim)")
        return
    end
    for i = 1, #_sources do self.list:AddTextItem(_sources[i]) end
end

--- Fill one source's pool, frame-spread by xslice so a large motion list never builds in one frame.
--- Fill the prop picker: back, a clear entry, then every attachable prop labelled by its group.
function tz_anim_tool_wnd:add_prop_rows()
    self.list:AddTextItem("..")
    self.list:AddTextItem("(none)")
    for i = 1, #PROPS do
        self.list:AddTextItem(string_format("%s  (%s)", PROPS[i].section, PROPS[i].group))
    end
end

function tz_anim_tool_wnd:add_pool_rows(row)
    if not row then return end
    self.list:AddTextItem("..")
    self.list:AddTextItem(string_format("[ prop:  %s ]", _prop or "none"))
    local list = self.list
    if not xslice then
        for i = 1, #row.pool do list:AddTextItem(row.pool[i].label) end
        return
    end
    xslice.start("tz_anim_fill", row.pool, { step = 20, func = function(entry)
        list:AddTextItem(entry.label)
        return true
    end })
end

function tz_anim_tool_wnd:render()
    if _view == VIEW_ROOT then
        self.lbl_path:SetText("sources in configs\\testzone\\anim    (click one)")
        self.status:SetText("pick a source file, or drop a .tsv / .txt in that folder")
    elseif _view == VIEW_PROP then
        self.lbl_path:SetText("props    (click one to attach, (none) to clear)")
        self.status:SetText("the pick attaches on the next play and persists across motions")
    else
        self.lbl_path:SetText(string_format("%s    (%d)", _row and _row.label or "?", _row and #_row.pool or 0))
        self.status:SetText("click a candidate to play    -    the [ prop: ] row picks an attachment")
    end
    if _npc_id then
        local bound = db.storage[_npc_id] and db.storage[_npc_id].object
        local live = (bound and bound:alive()) and state_mgr.get_state(bound) or "?"
        local mark = (_selected_id and _npc_id == _selected_id) and "* " or ""
        self.lbl_now:SetText(mark .. _get_clipped(tostring(_npc_name), 24))
        self.lbl_mode:SetText(string_format("%s  |  %s  |  %s",
            _get_clipped(tostring(live), 12), _get_mode().label, _prop or "no prop"))
    else
        self.lbl_now:SetText("** NO NPC **")
        self.lbl_mode:SetText("look at a stalker, reopen HOME")
    end
end

--- The mode label; it reads "(state - as wired)" for a state item, since modes only shape a raw motion.
function tz_anim_tool_wnd:_get_mode_label()
    if _cur and _cur.is_state then return _get_mode().label .. "  (state - as wired)" end
    return _get_mode().label
end

--- Pin the bound NPC as the standing selection, so it survives close and reopen; the band marks it with a leading star.
function tz_anim_tool_wnd:select_npc()
    if not _npc_id then self.status:SetText("no NPC bound. reopen while looking at a stalker"); return end
    _selected_id = _npc_id
    self.status:SetText(string_format("selected %s (stays bound on reopen)", tostring(_npc_name)))
    self:render()
end

--- Drop the standing selection and the current binding; the band falls back to NO NPC until the next open.
function tz_anim_tool_wnd:clear_selection()
    _selected_id = nil
    _npc_id, _npc_name = nil, nil
    self.status:SetText("selection cleared")
    self:render()
end

function tz_anim_tool_wnd:_play_current()
    if not (_cur and _npc_id and tz_anim) then return end
    local mode = _get_mode()
    local item = { name = _cur.name, is_state = _cur.is_state, moving = mode.moving, prop = _prop }
    if tz_anim.start_review_hold(_npc_id, item) then
        self.status:SetText(string_format("playing:  %s", _cur.name))
    end
end

function tz_anim_tool_wnd:select_row()
    local idx = self.list:GetSelectedIndex()
    if not idx or idx < 0 then return end
    if _view == VIEW_ROOT then
        self:select_root(idx)
    elseif _view == VIEW_PROP then
        self:select_prop(idx)
    else
        self:select_pool(idx)
    end
end

--- ROOT click: load the chosen source TSV into a pool and switch to the candidate list.
function tz_anim_tool_wnd:select_root(idx)
    local file = _sources[idx + 1]
    if not file then return end
    local row = _read_source(file)
    if not (row and #row.pool > 0) then self.status:SetText("empty or unreadable: " .. file); return end
    _row, _view = row, VIEW_POOL
    self:build_list(); self:render()
end

--- POOL click: index 0 returns to the source list; any other index plays that candidate on the bound NPC.
function tz_anim_tool_wnd:select_pool(idx)
    if idx == 0 then
        _view, _cur = VIEW_ROOT, nil
        if tz_anim then tz_anim.stop_review_hold() end
        self:build_list(); self:render()
        return
    end
    if idx == 1 then
        _view = VIEW_PROP
        self:build_list(); self:render()
        return
    end
    local entry = _row and _row.pool[idx - 1]
    if not entry then return end
    _cur = entry
    self:render()
    self.status:SetText("selected:  " .. entry.name .. "   (Play or double-click)")
end

--- PROP click: index 0 returns to the pool, index 1 clears the prop, any other index selects it.
--- The pick persists across motions and replays the current one so the change shows at once.
function tz_anim_tool_wnd:select_prop(idx)
    if idx == 0 then
        _view = VIEW_POOL
        self:build_list(); self:render()
        return
    end
    _prop = (idx == 1) and nil or (PROPS[idx - 1] and PROPS[idx - 1].section)
    _view = VIEW_POOL
    self:build_list(); self:render()
    if _cur then self:_play_current() end
    self.status:SetText(string_format("prop: %s", _prop or "none"))
end

function tz_anim_tool_wnd:play() self:_play_current() end

function tz_anim_tool_wnd:stop()
    if tz_anim then tz_anim.stop_review_hold() end
    self.status:SetText("stopped")
end

--- Mode steppers cycle how a motion is forced and replay the current item so the change is visible at once.
function tz_anim_tool_wnd:select_prev_mode()
    _mode_i = _mode_i - 1
    if _mode_i < 1 then _mode_i = #MODES end
    self:_play_current(); self:render()
end
function tz_anim_tool_wnd:select_next_mode()
    _mode_i = _mode_i % #MODES + 1
    self:_play_current(); self:render()
end

--- The pool index of the loaded candidate, or 1 when none is loaded.
function tz_anim_tool_wnd:find_pool_index()
    if not (_cur and _row) then return 1 end
    for k = 1, #_row.pool do
        if _row.pool[k].name == _cur.name then return k end
    end
    return 1
end

--- Step to a neighbouring candidate and play it (curation steps through and sees each in turn).
function tz_anim_tool_wnd:_select_neighbor(delta)
    if _view ~= VIEW_POOL or not (_row and #_row.pool > 0) then return end
    local at = (self:find_pool_index() - 1 + delta) % #_row.pool + 1
    _cur = _row.pool[at]
    self.list:SetSelectedIndex(at + 1)
    self:_play_current()
    self:render()
end

function tz_anim_tool_wnd:select_prev_item() self:_select_neighbor(-1) end
function tz_anim_tool_wnd:select_next_item() self:_select_neighbor(1) end

--- Write a verdict line for the current candidate; the typed note combines with the verdict word.
--- Verdicts: good (keep), bad (cut), note (a free-text observation only).
function tz_anim_tool_wnd:add_verdict(verdict)
    if not _cur then return end
    local note = self.snote:GetText()
    local written = _write_verdict(_cur.name, verdict, note)
    self.snote:SetText("")
    self.status:SetText(written and string_format("VERDICT %s = %s", _cur.name, verdict)
        or "verdict FAILED (no logs mount?)")
end

--- Esc closes the window when no edit box has focus, so game binds are never shadowed.
function tz_anim_tool_wnd:OnKeyboard(dik, action)
    local res = CUIScriptWnd.OnKeyboard(self, dik, action)
    if action ~= ui_events.WINDOW_KEY_PRESSED then return res end
    if res or dik ~= DIK_keys.DIK_ESCAPE then return res end
    self:hide()
    return true
end

function tz_anim_tool_wnd:hide()
    if xslice then xslice.stop_queue("tz_anim_fill") end
    if tz_anim then tz_anim.stop_review_hold() end
    self:HideDialog()
    Unregister_UI("tz_anim_tool_wnd")
end

function on_game_start()
    RegisterScriptCallback("on_key_press", function(key)
        if key == HOME_KEY then try_open() end
    end)
end
