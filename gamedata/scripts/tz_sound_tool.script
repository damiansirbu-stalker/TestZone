--- tz_sound_tool: SoundTool - play any sound as its X-Ray producer does, at the ear or at a distance, and note a verdict. MCM TestZone > SoundTool.

local string_format, table_sort, table_insert = string.format, table.sort, table.insert
local math_sqrt, math_floor, math_random, math_cos, math_sin, math_pi = math.sqrt, math.floor, math.random, math.cos, math.sin, math.pi
local ipairs, pairs, tonumber, tostring, GetEvent = ipairs, pairs, tonumber, tostring, GetEvent
local os_date, os_time, os_clock, ini_file, RegisterScriptCallback = os.date, os.time, os.clock, ini_file, RegisterScriptCallback

-- The prefix of this tool's file per game run in the logs folder (tz_ui.write_line).
local OUTPUT_TOOL  = "sound_tool"
local VERDICT_NOTE = "note"
local SOUNDS_MOUNT = "$game_sounds$"
local CACHE_DIR    = "sound_tool_cache"
local FILL_QUEUE   = "tz_sound_fill"
local FILL_STEP    = 15
local DREAD_ROOT   = "zs\\"
local NO_SOUND     = "ambient\\no_sound"
local VOICE_MARK   = "\\voice\\audio\\"
local VOICE_ROOT   = "characters_voice\\human\\"
local VOICE_BASE   = "characters_voice\\"
local CREATURE_ROOT = "monsters\\"
local EXT_OGG, EXT_TXT = "ogg", "txt"
-- The roots the producers open; each root's #includes merge into it (sound_theme.script:837, xray Environment.cpp:186-191).
local THEME_FILE   = "misc\\sound\\script_sound.ltx"
local THUNDER_FILE = "environment\\thunderbolts.ltx"
local AMBIENTS_FILE = "environment\\ambients.ltx"
local LEVEL_AMBIENT = "environment\\ambients\\%s.ltx"
-- A bed plays randF(min, max) from the camera on a random bearing, 10 m up (xray/xrGame/GamePersistent.cpp:338-349).
local BED_LIFT = 10
-- A theme of type actor plays 2D at the ear at this volume (anomaly/sound_theme.script:489-491).
local ACTOR_THEME_VOLUME = 0.8
-- The 3D presets, where the Diegetic mods' plays sit: beds, the near tenth, the median, the far end, the farthest channel, the farthest bed.
local DIST_PRESETS = { 3, 15, 40, 60, 100, 200 }
local DIST_FIRST = 40
-- The first bytes of an ogg hold its comment header, the falloff blob xsound.parse_blob reads.
local BLOB_BYTES = 4096
-- The modes: game is the producer's own play, 2D at the ear, 3D camera-forward at the kept distance.
local GROUP_GAME, GROUP_2D, GROUP_3D = "game", "2d", "3d"
local GROUP_ORDER = { GROUP_GAME, GROUP_2D, GROUP_3D }
-- Producer kinds, in the order the detection tries them.
local KIND_DREAD, KIND_CHANNEL, KIND_THEME, KIND_THUNDER = "dread", "channel", "theme", "thunder"
local KIND_VOICE, KIND_CREATURE, KIND_NONE = "voice", "creature", "none"
local THEME_ACTOR, THEME_NPC = "actor", "npc"
-- The last-lines screen and the loudness row: the newest lines written, clipped to the row width.
local FEED_MAX, FEED_CHARS = 2, 44
local LOUD_CHARS = 56
-- Decor the window draws and never touches again: the panel frame, the screens' rim and glass, the lines and the verdict box.
local DECOR = { statics = { "hdr_tool", "scr_list_rim", "scr_list_glass", "list_line", "scr_display_rim", "scr_display_glass",
    "verdict_box_t", "verdict_box_b", "verdict_box_l", "verdict_box_r", "scr_sel_rim", "scr_sel_glass", "scr_note_rim", "scr_note_glass",
    "note_plus_h", "note_plus_v", "scr_feed_rim", "scr_feed_glass", "scr_dist_rim", "scr_dist_glass", "scr_height_rim", "scr_height_glass",
    "scr_min_dist_rim", "scr_min_dist_glass", "scr_max_dist_rim", "scr_max_dist_glass" } }
-- The volume keys: the playback volume each later play starts at, stepped between these bounds; a one-shot keeps the volume it started with.
local GAIN_STEP, GAIN_MIN, GAIN_MAX = 0.1, 0.1, 1.0
-- While a play sounds, the lamps refresh this often, in seconds, so green turns red when it ends by itself.
local LAMP_PERIOD = 0.25
local LAMP_EV = "tz_sound_tool"
-- The answer the mute gives every seam: a 0 vetoes the play.
local MUTE_RESULT = { volume_mult = 0 }
-- The level music factor xray starts at, never saved, scaling music only (xray/xrSound/SoundRender_Core.cpp:27, SoundRender_Emitter_FSM.cpp:394).
local MUSIC_FACTOR_FULL = 1
-- The MCM option that holds the mute across level changes and loads.
local MUTE_OPTION = "soundtool_mute"
-- A mode key's label, and the brighter label of the lit one, as AnimationTool marks its posture keys.
local LABEL_RGB, LABEL_LIT_RGB = { 175, 180, 190 }, { 235, 240, 245 }

local log = xlog.get_logger("TestZone.soundtool", { outfile = "testzone.log" })

-- The channel rows (an xsound channel record and how the presets schedule it), the dread categories, and the theme and thunder indexes.
local _channel_rows, _row_of, _dread_categories = {}, {}, {}
local _themes, _thunder = nil, nil
-- xray keeps each loaded sound source by name until exit (xray/xrSound/SoundRender_Core_SourceManager.cpp:8-31), so a cache name is never reused.
local _cache, _cache_count, _is_cache_dirty, _cache_token = {}, 0, false, nil
local _handles = {}
local _feed = {}
-- The mute: on, the own-play pass flag, and the plays it blocked.
local _is_muted, _is_own_play = false, false
local _blocked_count = 0
-- Where the window stood when it last closed: its view, sound, mode, volume, distance, settings and list place, put back on the next open.
local _kept = nil
local _walk_ini = nil
local VIEW_ROOT, VIEW_DRIVES, VIEW_FOLDER, VIEW_POOL = "root", "drives", "folder", "pool"

local function _get_extension(name)
    return (name:match("%.([^%.\\]+)$") or ""):lower()
end

local function _get_tail(path)
    return path:match("([^\\]+)$") or path
end

local function _is_absolute(path)
    return path:match("^%a:\\") ~= nil
end

local function _get_sounds_dir()
    return xfs.format_dir(xfs.resolve_path(SOUNDS_MOUNT, ""))
end

local function _is_sound_known(key)
    return xfs.has_file(SOUNDS_MOUNT, key .. ".ogg")
end

--- Delete every file in the cache folder, then rescan when one went, so the index forgets them.
--- @return number The number of files deleted
local function _clear_cache()
    local dir = _get_sounds_dir() .. CACHE_DIR
    local _, files = xfs.read_disk_entries(dir)
    for i = 1, #files do xfs.remove_file(dir .. "\\" .. files[i]) end
    _cache, _is_cache_dirty = {}, false
    if #files > 0 then xfs.update_index(SOUNDS_MOUNT) end
    return #files
end

--- A cache name unique for the whole process: the load's time token, a counter that never resets, then the file name.
local function _build_cache_name(source)
    _cache_token = _cache_token or os_time()
    _cache_count = _cache_count + 1
    local tail = _get_tail(source):lower():gsub("%.ogg$", ""):gsub("[^%w_%-]", "_")
    return string_format("%s\\%d_%04d_%s", CACHE_DIR, _cache_token, _cache_count, tail)
end

--- Copy an outside file into the cache once and return its game name; the copy plays after the next _flush_cache.
local function _add_cache_entry(source)
    local key = source:lower()
    if _cache[key] then return _cache[key] end
    local sounds_dir = _get_sounds_dir()
    xfs.create_folder(sounds_dir:sub(1, -2))
    xfs.create_folder(sounds_dir .. CACHE_DIR)
    local name = _build_cache_name(source)
    if not xfs.clone_file(source, sounds_dir .. name .. ".ogg") then log.warn("[SOUNDTOOL] copy failed: %s", source); return nil end
    _cache[key] = name
    _is_cache_dirty = true
    return name
end

local function _flush_cache()
    if not _is_cache_dirty then return end
    xfs.update_index(SOUNDS_MOUNT)
    _is_cache_dirty = false
end

--- Run one of the tool's own plays with the flag up, so the mute lets it through.
local function _run_own_play(play, path, opts)
    _is_own_play = true
    local first, second = play(path, opts)
    _is_own_play = false
    return first, second
end

--- The mute's seam listener: every play the seams reach is vetoed, the tool's own plays pass.
local function _get_mute_result()
    if _is_own_play then return nil end
    _blocked_count = _blocked_count + 1
    return MUTE_RESULT
end

--- Stop what already plays that Lua can reach, so the mute is heard at once: the actor's looped wind, drone and rain sounds.
--- vanilla's update_wind restarts them each update (anomaly/sound_ambient.script:276-284), and the script seam vetoes each restart.
local function _stop_reachable_sounds()
    if xr_sound and xr_sound.stop_sound_looped then xr_sound.stop_sound_looped(xconst.ACTOR_ENTITY_ID) end
end

--- Set xray's level music factor, where the exe binds it (xray/xrGame/level_script.cpp:1103-1106).
local function _set_music_factor(value)
    if level.set_music_volume then level.set_music_volume(value) end
end

--- Put the mute's listener on every seam or take it off, and hold the level music factor at 0 while it is on.
--- On an exe without the seams nothing attaches and the mute stays off.
local function _set_muted(is_on)
    if is_on == _is_muted then return end
    local is_attached = false
    for _, seam in pairs(xsound.SEAM) do
        if is_on then
            is_attached = xsound.register_ambient_listener(seam, _get_mute_result) or is_attached
        else
            xsound.unregister_ambient_listener(seam, _get_mute_result)
        end
    end
    _is_muted = is_on and is_attached
    if _is_muted then
        _blocked_count = 0
        _set_music_factor(0)
        _stop_reachable_sounds()
    elseif not is_on then
        _set_music_factor(MUSIC_FACTOR_FULL)
        log.info("[SOUNDTOOL] mute off: %d plays blocked", _blocked_count)
    end
end

--- Apply the saved mute option. At load it runs before any bed, wind or music starts, so nothing that was playing survives it.
local function _apply_mute_option()
    _set_muted(tz_mcm.get_config(MUTE_OPTION) == true)
end

--- Add every channel name one preset key lists in a resolved ambient ini to the set out, keyed lowercase.
local function _collect_preset_channels(rel, key, out)
    local ini = ini_file(rel)
    if not (ini and ini.section_for_each) then return end
    ini:section_for_each(function(sec)
        if not ini:line_exist(sec, key) then return end
        for token in (ini:r_string_ex(sec, key) or ""):gmatch("[^,]+") do out[token:match("^%s*(.-)%s*$"):lower()] = true end
    end)
end

--- How many files a channel's pool plays, its ambient\no_sound placeholders left out.
local function _compute_playable_count(record)
    local count = 0
    for i = 1, #record.pool do
        if xsound.format_key(record.pool[i]) ~= NO_SOUND then count = count + 1 end
    end
    return count
end

--- Build the channel rows from the xsound index: a bed when a preset's sound_channels lists it, a Lua play when the level's dynamic list does or none.
--- A channel with no playable file gets no row.
local function _build_channel_rows()
    local beds, dynamic = {}, {}
    local level_rel = LEVEL_AMBIENT:format(level.name())
    _collect_preset_channels(AMBIENTS_FILE, "sound_channels", beds)
    _collect_preset_channels(level_rel, "sound_channels", beds)
    _collect_preset_channels(level_rel, "sound_channels_dynamic", dynamic)
    _channel_rows, _row_of = {}, {}
    for name, record in pairs(xsound.get_channel_index().channels) do
        local playable = _compute_playable_count(record)
        if playable > 0 then
            local is_bed, is_lua = beds[name] or false, dynamic[name] or false
            local row = { record = record, playable = playable, is_bed = is_bed and not is_lua, is_lua = is_lua }
            _channel_rows[#_channel_rows + 1] = row
            _row_of[name] = row
        end
    end
    table_sort(_channel_rows, function(left, right) return left.record.name < right.record.name end)
end

--- Where a channel's sound plays on this level: a Lua play rolls random(spawn_min, max) / 2 from the actor, a bed randF(min, max) 10 m up.
--- A channel no preset of this level lists does not play here.
--- @src anomaly/sound_ambient.script:127-129, xray/xrGame/GamePersistent.cpp:342-348
local function _format_band(row)
    local record = row.record
    if row.is_lua then
        local spawn_min = GetEvent("underground") and record.min_dist or (record.min_dist + record.max_dist) / 2
        if spawn_min > record.max_dist then spawn_min = record.max_dist end
        return string_format("%g-%g m", spawn_min / 2, record.max_dist / 2)
    end
    if row.is_bed then return string_format("%g-%g m, %d up", record.min_dist, record.max_dist, BED_LIFT) end
    return "not played here"
end

--- The channel rows that list a sound key, in index order, or nil.
local function _find_channel_rows(key)
    local names = xsound.get_channel_index().owners[key]
    if not names then return nil end
    local rows = {}
    for i = 1, #names do
        if _row_of[names[i]] then rows[#rows + 1] = _row_of[names[i]] end
    end
    return #rows > 0 and rows or nil
end

--- Section-walk handler for the theme root: a theme keyed by the path it plays, or by its tail when it plays under each NPC's own prefix.
--- An npc theme without npc_prefix plays under characters_voice, an actor theme with it too (anomaly/sound_theme.script:82-104, 402-404).
local function _add_theme(section)
    local path = _walk_ini:r_string_ex(section, "path")
    if not path or path == "" then return end
    local theme = { section = section, type = _walk_ini:r_string_ex(section, "type") or "" }
    local is_prefixed = _walk_ini:r_bool_ex(section, "npc_prefix", false)
    local key = xsound.format_key(path)
    if theme.type == THEME_NPC and is_prefixed then _themes.by_tail[key] = _themes.by_tail[key] or theme; return end
    if (theme.type == THEME_NPC) ~= is_prefixed then key = VOICE_BASE .. key end
    _themes.by_path[key] = _themes.by_path[key] or theme
end

local function _add_thunder(section)
    local sound = _walk_ini:r_string_ex(section, "sound")
    if sound and sound ~= "" then _thunder[xsound.format_key(sound)] = section end
end

--- Walk one root config with a section handler.
local function _iterate_root(rel, handler)
    local ini = ini_file(rel)
    if not (ini and ini.section_for_each) then return end
    _walk_ini = ini
    ini:section_for_each(handler)
    _walk_ini = nil
end

--- Build the theme and thunder indexes, one walk of each root; the counts log on the open line with their cost.
local function _build_producer_index()
    _themes, _thunder = { by_path = {}, by_tail = {} }, {}
    _iterate_root(THEME_FILE, _add_theme)
    _iterate_root(THUNDER_FILE, _add_thunder)
end

--- A sound key with its trailing digits cut, the base of a numbered set.
local function _get_set_base(key)
    return (key:gsub("%d+$", ""))
end

--- The theme that plays a key: a single path, a numbered set's base, or an NPC theme matched on the tail after the NPC's prefix.
local function _find_theme(key)
    local by_path = _themes.by_path
    local theme = by_path[key] or by_path[_get_set_base(key)]
    if theme or key:sub(1, #VOICE_BASE) ~= VOICE_BASE then return theme end
    for at in key:gmatch("()\\") do
        local tail = key:sub(at + 1)
        theme = _themes.by_tail[tail] or _themes.by_tail[_get_set_base(tail)]
        if theme then return theme end
    end
    return nil
end

local function _is_dread_available()
    return dd_director ~= nil and dd_sound_metadata ~= nil
end

local function _build_dread_index()
    _dread_categories = _is_dread_available() and xfs.read_folders(SOUNDS_MOUNT, DREAD_ROOT) or {}
    table_sort(_dread_categories)
end

local function _get_dread_category(key)
    return key:match("^zs\\([^\\]+)\\") or "?"
end

--- The deployed DiegeticDread row of a zs key, or nil.
local function _find_dread_row(key)
    local categories = _is_dread_available() and dd_sound_metadata.categories
    local rows = categories and categories[_get_dread_category(key)] or {}
    for i = 1, #rows do
        if rows[i].path == key then return rows[i] end
    end
    return nil
end

--- The record key of an outside file: its path below a gamedata\sounds folder, so a mod's own file finds its producer and row.
local function _get_source_key(source)
    local rel = source:lower():match("\\gamedata\\sounds\\(.+)%.ogg$")
    return rel and rel:gsub("/", "\\") or nil
end

local function _is_voice_member(item)
    return item.source ~= nil and item.source:lower():find(VOICE_MARK, 1, true) ~= nil
end

--- A channel producer: the row the item was opened from or the first that lists it, and the others counted after it.
local function _build_channel_producer(item, rows)
    local row = item.channel or rows[1]
    local state = row.is_lua and "lua" or row.is_bed and "bed" or "unused here"
    local label = string_format("channel %s (%s)", row.record.name, state)
    if #rows > 1 then label = string_format("%s +%d", label, #rows - 1) end
    local reason = not (row.is_lua or row.is_bed) and "game: this level plays no preset that lists it" or nil
    return { kind = KIND_CHANNEL, label = label, row = row, where = "channel " .. row.record.name, reason = reason }
end

--- A producer from a key that sits under no channel: a theme, a thunder strike, an NPC voice, a creature, or none.
local function _build_other_producer(key)
    local theme = _find_theme(key)
    if theme then
        local reason = theme.type ~= THEME_ACTOR and string_format("game: theme %s plays at an object or an NPC", theme.type) or nil
        return { kind = KIND_THEME, label = string_format("theme %s (%s)", theme.section, theme.type), theme = theme, reason = reason }
    end
    if _thunder[key] then return { kind = KIND_THUNDER, label = "thunder strike", reason = "game: thunder waits on its phase" } end
    if key:sub(1, #VOICE_ROOT) == VOICE_ROOT then
        local community, category = key:match("^characters_voice\\human\\([^\\]+)\\([^\\]+)\\")
        return { kind = KIND_VOICE, label = string_format("voice %s/%s", community or "?", category or "?"), reason = "game: voice, phase 3" }
    end
    if key:sub(1, #CREATURE_ROOT) == CREATURE_ROOT then
        return { kind = KIND_CREATURE, label = "creature " .. (key:match("^monsters\\([^\\]+)\\") or "?"), reason = "game: creature, phase 3" }
    end
    return { kind = KIND_NONE, label = "no indexed producer", reason = "game: no indexed producer" }
end

--- The producer that plays a key, the first match in order: dread, channel, theme, thunder, voice, creature, else none.
local function _find_key_producer(item, key)
    if key:sub(1, #DREAD_ROOT) == DREAD_ROOT then
        local row = _find_dread_row(key)
        local category = _get_dread_category(key)
        return { kind = KIND_DREAD, label = "dread " .. category, row = row, where = "category " .. category,
            reason = not row and "dread: no deployed row" or nil }
    end
    local rows = _find_channel_rows(key)
    if rows then return _build_channel_producer(item, rows) end
    return _build_other_producer(key)
end

--- The item's producer; an outside file shows where it would land, and only a file the game loads plays as game.
local function _find_producer(item)
    local producer
    if item.key then
        producer = _find_key_producer(item, item.key)
    elseif _is_voice_member(item) then
        local corpus = item.source:lower():match("\\voice\\audio\\([^\\]+\\[^\\]+)\\") or "?"
        producer = { kind = KIND_VOICE, label = "voice " .. corpus:gsub("\\", "/") }
    else
        producer = { kind = KIND_NONE, label = "unknown, the path holds no gamedata\\sounds" }
    end
    if item.source then
        producer.label = "would play as: " .. producer.label
        producer.reason = "game: external file"
    end
    producer.where = producer.where or (item.source and item.source:match("([^\\]+)\\[^\\]+$")) or "game"
    return producer
end

local function _build_source_item(source, comment)
    local item = { source = source, key = _get_source_key(source), label = _get_tail(source), comment = comment }
    item.producer = _find_producer(item)
    return item
end

local function _build_game_item(key, channel)
    local item = { key = key, path = key, label = _get_tail(key), channel = channel }
    item.producer = _find_producer(item)
    return item
end

--- Resolve one playlist line: absolute, then known under $game_sounds$, then under the base folder, then a divider or unclaimed.
local function _resolve_line(line, base_dir, comment)
    local bare = line:gsub("/", "\\"):gsub("%.[oO][gG][gG]$", "")
    if _is_absolute(bare) then return _build_source_item(bare .. ".ogg", comment) end
    local key = xsound.format_key(bare)
    if _is_sound_known(key) then
        local item = _build_game_item(key)
        item.comment = comment
        return item
    end
    local beside = base_dir .. bare .. ".ogg"
    if xfs.is_file(beside) then return _build_source_item(beside, comment) end
    if not bare:find("\\", 1, true) then return { is_divider = true, label = "-- " .. bare .. " --" } end
    return { label = bare .. "  [unclaimed]" }
end

--- Copy every outside item of a row into the cache, then rescan once for the whole batch.
--- @return number copied, number failed
local function _load_row_sources(row)
    local copied, failed = 0, 0
    for i = 1, #row.items do
        local item = row.items[i]
        if item.source and not item.path then
            item.path = _add_cache_entry(item.source)
            copied = copied + (item.path and 1 or 0)
            failed = failed + (item.path and 0 or 1)
        end
    end
    _flush_cache()
    if copied + failed > 0 then log.info("[SOUNDTOOL] %s: copied %d outside files, %d failed", row.name, copied, failed) end
    return copied, failed
end

--- A playlist from any absolute path. A "; base: <folder>" line moves the relative base, and the comment right above an entry is that entry's.
local function _load_playlist(path)
    local data = xfs.read_file(path)
    if not data then return nil end
    local base_dir = path:match("^(.*\\)") or ""
    local items, comment = {}, nil
    for raw in data:gmatch("[^\r\n]+") do
        local line = raw:match("^%s*(.-)%s*$")
        local base = line:match("^;%s*base:%s*(.-)%s*$")
        if base and base ~= "" then
            base_dir = xfs.format_dir(base)
        elseif line:sub(1, 1) == ";" then
            comment = line:match("^;%s*(.-)$")
        elseif line ~= "" then
            items[#items + 1] = _resolve_line(line, base_dir, comment)
            comment = nil
        end
    end
    log.info("[SOUNDTOOL] playlist %s: %d lines", path, #items)
    return { name = "playlist " .. _get_tail(path), items = items }
end

local function _build_folder_row(dir)
    local _, files = xfs.read_disk_entries(dir:sub(1, -2))
    table_sort(files)
    local items = {}
    for i = 1, #files do
        if _get_extension(files[i]) == EXT_OGG then items[#items + 1] = _build_source_item(dir .. files[i]) end
    end
    return { name = "folder " .. dir, items = items }
end

local function _build_dread_row(category)
    local files = xfs.read_files(SOUNDS_MOUNT, DREAD_ROOT .. category .. "\\", ".ogg")
    table_sort(files)
    local items = {}
    for i = 1, #files do items[i] = _build_game_item(DREAD_ROOT .. category .. "\\" .. files[i]:lower()) end
    return { name = "dread " .. category, items = items }
end

local function _build_channel_row(row)
    local record = row.record
    local items = {}
    for i = 1, #record.pool do
        local key = xsound.format_key(record.pool[i])
        if key ~= NO_SOUND then items[#items + 1] = _build_game_item(key, row) end
    end
    return { name = string_format("channel %s  %s  h%g", record.name, _format_band(row), record.height), items = items }
end

local function _is_playable(item)
    return item ~= nil and not item.is_divider and item.path ~= nil
end

--- True when the item has a producer the tool can replay: a deployed dread row, a channel, or an actor theme, and the file is the game's own.
local function _can_play_game(item)
    if not _is_playable(item) then return false end
    local producer = item.producer
    return producer.reason == nil and (producer.kind ~= KIND_DREAD or _is_dread_available())
end

--- The mode an item plays in: the lit one, else 3D, which every item has.
local function _select_group(item, group)
    if group == GROUP_GAME and not _can_play_game(item) then return GROUP_3D end
    return group
end

--- True while any play the tool started is still sounding; xsound sweeps a one-shot when it ends.
local function _is_playing()
    for i = 1, #_handles do
        if xsound.is_active(_handles[i]) then return true end
    end
    return false
end

--- The falloff blob of the item's file, read once: the outside file's own bytes, or the game copy's when it sits loose on disk.
local function _get_item_blob(item)
    if item.blob == nil then
        local path = item.source or xfs.resolve_path(SOUNDS_MOUNT, item.key .. ".ogg")
        item.blob = xsound.parse_blob(xfs.read_bytes(path, BLOB_BYTES)) or false
    end
    return item.blob or nil
end

--- The point in front of the camera at a flat distance from the actor, lifted by a height from the actor's feet; nil without an actor.
local function _compute_front_pos(dist, height)
    local actor = db.actor
    if not actor then return nil end
    local dir = device().cam_dir
    local flat = vector():set(dir.x, 0, dir.z)
    if flat:magnitude() < 0.01 then flat = vector():set(0, 0, 1) end
    flat:normalize()
    local pos = vector():set(actor:position()):add(flat:mul(dist))
    pos.y = pos.y + height
    return pos
end

--- A Lua channel's play, vanilla's roll and volume through xsound, past DiegeticAmbience's shuffle when it is installed.
local function _play_lua_channel(item, row, gain)
    local record = row.record
    local dist = xsound.compute_spawn_dist(record.min_dist, record.max_dist)
    local slider = (ui_options and ui_options.get("sound/environment/ambient_volume")) or 1
    local volume = xsound.compute_channel_volume(record, slider) * gain
    local play = da_director and da_director.play_unfiltered or xsound.play_at
    local handle = _run_own_play(play, item.path, { position = xsound.compute_spawn_pos(dist, record.height), volume = volume })
    return handle, { dist = math_sqrt(dist * dist + record.height * record.height), volume = volume,
        text = string_format("lua | %.0f m | h%g | vol %.2f", dist, record.height, volume) }
end

--- A bed's play as the engine rolls it: randF(min, max) from the camera on a random bearing, 10 m up, typed from its own blob.
--- @src xray/xrGame/GamePersistent.cpp:338-349
local function _play_bed_channel(item, row, gain)
    local record = row.record
    local span = record.max_dist - record.min_dist
    local dist = span > 0 and record.min_dist + math_random() * span or 0
    local angle = math_random() * 2 * math_pi
    local cam = device().cam_pos
    local pos = vector():set(cam.x + math_cos(angle) * dist, cam.y + BED_LIFT, cam.z + math_sin(angle) * dist)
    local blob = _get_item_blob(item)
    local handle = _run_own_play(xsound.play_at, item.path, { position = pos, volume = gain, type = blob and blob.game_type })
    return handle, { dist = math_sqrt(dist * dist + BED_LIFT * BED_LIFT), volume = gain,
        text = string_format("bed | %.0f m | h%d | vol %.2f%s", dist, BED_LIFT, gain, blob and "" or " | untyped") }
end

--- A dread sound through the director's own roll at the live board dread, at its volume times the tool's.
local function _play_dread(item, row, gain)
    local board = dd_director.get_board()
    local dread = board and board.dread or 0
    local dist, handle = _run_own_play(dd_director.play_sound, item.path,
        { ch_min = row.ch_min, ch_max = row.ch_max, height = row.h or 0, dread = dread, volume = gain })
    local height = row.h or 0
    return handle, { dist = dist and math_sqrt(dist * dist + height * height), volume = gain,
        text = string_format("dread %.2f | %.0f m | h%g | vol x%.2f", dread, dist or 0, height, gain) }
end

--- One play the way the item's producer plays it; the roll comes back for the screen and the notes line.
local function _play_game(item, gain)
    local producer = item.producer
    local kind, row = producer.kind, producer.row
    if kind == KIND_DREAD then return _play_dread(item, row, gain) end
    if kind == KIND_CHANNEL and row.is_lua then return _play_lua_channel(item, row, gain) end
    if kind == KIND_CHANNEL then return _play_bed_channel(item, row, gain) end
    local volume = ACTOR_THEME_VOLUME * gain
    local handle = _run_own_play(xsound.play_at, item.path, { s2d = true, volume = volume })
    return handle, { volume = volume, text = string_format("actor | 2D | vol %.2f", volume) }
end

local function _stop_plays()
    for i = 1, #_handles do xsound.stop_shot(_handles[i]) end
    _handles = {}
end

--- One line in this game run's file: the source, the verdict, the sound, its producer kind and producer, where it belongs, the play, the typed note.
--- @return boolean True when the line was written
local function _write_verdict(source, item, verdict, play_text, typed)
    local producer = item.producer
    return tz_ui.write_line(OUTPUT_TOOL, source, verdict, item.source or item.path, producer.kind, producer.label, producer.where,
        play_text, typed)
end

--- Put one written line at the top of the feed, clipped so it fits its row.
local function _add_feed_line(item, text)
    local short = string_format("%s  %s :: %s", os_date("%H:%M:%S"), item.label, text)
    xcui.push_line(_feed, short, FEED_MAX, FEED_CHARS)
end

local function _try_open()
    if Check_UI() or not db.actor then return end
    local window = tz_sound_tool_wnd()
    window:ShowDialog(true)
    Register_UI("tz_sound_tool_wnd", "tz_sound_tool", window)
end

local function _on_key_press(key)
    if key == tz_mcm.get_config("soundtool_key") then _try_open() end
end

--- A level change or a load: stop the fill, the lamp watch and the tool's plays, and lift the dread silence.
--- The mute lifts too, so the main menu keeps its music; the next load applies the saved option again.
local function _on_actor_destroy()
    xslice.stop_queue(FILL_QUEUE, true)
    RemoveTimeEvent(LAMP_EV, "lamps")
    _stop_plays()
    _set_muted(false)
    if _is_dread_available() then dd_director.set_muted(false) end
    Unregister_UI("tz_sound_tool_wnd")
end

--- A number typed into a box, or nil when it holds none.
local function _read_box(box)
    return tonumber(box:GetText())
end

class "tz_sound_tool_wnd" (CUIScriptWnd)

function tz_sound_tool_wnd:__init() super()
    self:SetWndRect(Frect():set(0, 0, 1024, 768))
    self:SetAutoDelete(true)
    local kept = _kept or {}
    self.entries, self.is_built = {}, false
    self.row, self.items, self.index, self.dir, self.view = nil, nil, nil, nil, nil
    self.mode_group, self.gain, self.dist = kept.mode_group or GROUP_GAME, kept.gain or GAIN_MAX, kept.dist or DIST_FIRST
    self.last_play = nil
    self:init_controls()
    self:init_callbacks()
    self.box_dist:SetText(tostring(self.dist))
    self.box_height:SetText(tostring(kept.height or 0))
    self.box_min_dist:SetText(kept.min_dist and tostring(kept.min_dist) or "")
    self.box_max_dist:SetText(kept.max_dist and tostring(kept.max_dist) or "")
    local cleared = _clear_cache()
    local started = os_clock()
    self:build_indexes()
    local index_ms = (os_clock() - started) * 1000
    if _is_dread_available() then dd_director.set_muted(true) end
    self:show_view(kept)
    log.info("[SOUNDTOOL] open: %d channels, %d dread categories, indexes %.1f ms, cleared %d cached files",
        #_channel_rows, #_dread_categories, index_ms, cleared)
end

--- The window's controls in draw order. Each lit outline comes before its key, so it sits under the key's open outline and never takes the click.
function tz_sound_tool_wnd:get_layout()
    local presets = {}
    for i = 1, #DIST_PRESETS do presets[i] = "btn_dist_" .. DIST_PRESETS[i] end
    local spec = {
        { kind = "static", names = tz_ui.PANEL },
        { kind = "static", names = DECOR.statics },
        { kind = "text", names = xcui.get_names("feed_row_", FEED_MAX) },
        { kind = "list", names = { "list" } },
        { kind = "text", names = { "lbl_path", "lbl_now", "lbl_place", "lbl_loud", "sel_line", "lbl_height", "lbl_height_unit",
            "lbl_falloff", "lbl_falloff_dash", "lbl_falloff_unit", "lbl_falloff_hint" } },
        { kind = "static", names = { "lamp_green", "lamp_red" } },
        { kind = "edit", names = { "note", "box_dist", "box_height", "box_min_dist", "box_max_dist" } },
        { kind = "button", names = { "btn_help", "btn_vol_down", "btn_vol_up", "btn_prior", "btn_play", "btn_next", "btn_stop", "btn_good", "btn_bad", "btn_note", "btn_rescan" } },
        { kind = "button", names = presets },
    }
    for _, group in ipairs(GROUP_ORDER) do
        spec[#spec + 1] = { kind = "line", names = { "lit_mode_" .. group } }
        spec[#spec + 1] = { kind = "button", names = { "btn_mode_" .. group } }
    end
    return spec
end

function tz_sound_tool_wnd:init_controls()
    local xml = CScriptXmlInit()
    xml:ParseFile("tz_sound_tool.xml")
    local ui = xcui.build(xml, self, self:get_layout())
    self.ui = ui
    self.list = ui.list
    self.list:ShowSelectedItem(true)
    self.lbl_path, self.lbl_now, self.lbl_place, self.lbl_loud, self.sel_line = ui.lbl_path, ui.lbl_now, ui.lbl_place, ui.lbl_loud, ui.sel_line
    self.note, self.box_dist, self.box_height = ui.note, ui.box_dist, ui.box_height
    self.box_min_dist, self.box_max_dist = ui.box_min_dist, ui.box_max_dist
    self.feed_rows = xcui.get_controls(ui, xcui.get_names("feed_row_", FEED_MAX))
    self.mode_keys, self.mode_lits = {}, {}
    for _, group in ipairs(GROUP_ORDER) do
        self.mode_keys[group], self.mode_lits[group] = ui["btn_mode_" .. group], ui["lit_mode_" .. group]
    end
end

function tz_sound_tool_wnd:add_mode_callback(group)
    self:AddCallback("btn_mode_" .. group, ui_events.BUTTON_CLICKED, function() self:select_mode_group(group) end, self)
end

function tz_sound_tool_wnd:add_preset_callback(dist)
    self:AddCallback("btn_dist_" .. dist, ui_events.BUTTON_CLICKED, function() self:play_at_dist(dist) end, self)
end

function tz_sound_tool_wnd:init_callbacks()
    self:AddCallback("list", ui_events.LIST_ITEM_CLICKED, self.select_row, self)
    self:AddCallback("btn_help", ui_events.BUTTON_CLICKED, self.show_help, self)
    for _, group in ipairs(GROUP_ORDER) do self:add_mode_callback(group) end
    for i = 1, #DIST_PRESETS do self:add_preset_callback(DIST_PRESETS[i]) end
    self:AddCallback("btn_vol_down", ui_events.BUTTON_CLICKED, function() self:select_gain(-1) end, self)
    self:AddCallback("btn_vol_up", ui_events.BUTTON_CLICKED, function() self:select_gain(1) end, self)
    self:AddCallback("btn_prior", ui_events.BUTTON_CLICKED, function() self:select_neighbor(-1) end, self)
    self:AddCallback("btn_next", ui_events.BUTTON_CLICKED, function() self:select_neighbor(1) end, self)
    self:AddCallback("btn_play", ui_events.BUTTON_CLICKED, self.play_current, self)
    self:AddCallback("btn_stop", ui_events.BUTTON_CLICKED, self.stop_current, self)
    self:AddCallback("btn_good", ui_events.BUTTON_CLICKED, function() self:add_verdict("good") end, self)
    self:AddCallback("btn_bad", ui_events.BUTTON_CLICKED, function() self:add_verdict("bad") end, self)
    self:AddCallback("btn_note", ui_events.BUTTON_CLICKED, function() self:add_verdict(VERDICT_NOTE) end, self)
    self:AddCallback("btn_rescan", ui_events.BUTTON_CLICKED, self.update_indexes, self)
end

--- Replace the list with these entries; each entry is { label, on_select }, and list index i maps to entries[i + 1].
function tz_sound_tool_wnd:set_entries(entries, title)
    xslice.stop_queue(FILL_QUEUE, true)
    if self.is_built then self.list:RemoveAll() end
    self.is_built = true
    self.entries = entries
    for i = 1, #entries do
        if entries[i].label then self.list:AddTextItem(entries[i].label) end
    end
    self.lbl_path:SetText(title)
end

function tz_sound_tool_wnd:select_row()
    local list_index = self.list:GetSelectedIndex()
    local entry = list_index and list_index >= 0 and self.entries[list_index + 1]
    if entry and entry.on_select then entry.on_select() end
end

function tz_sound_tool_wnd:build_dread_entry(category)
    return { label = "dread  " .. category .. "/", on_select = function() self:show_pool(function() return _build_dread_row(category) end, nil) end }
end

function tz_sound_tool_wnd:build_channel_entry(row)
    local record = row.record
    local label = string_format("%s%s  (%d)  %s", row.is_bed and "[bed] " or "", record.name, row.playable, _format_band(row))
    return { label = label, on_select = function() self:show_pool(function() return _build_channel_row(row) end, nil) end }
end

--- A disk browser row as an entry: a folder opens, a playlist plays, and the drive list's ".." returns to root.
function tz_sound_tool_wnd:build_browse_entry(row)
    if row.path then return self:build_playlist_entry(row.path) end
    if row.dir then return { label = row.label, on_select = function() self:show_folder(row.dir) end } end
    return { label = row.label, on_select = function() self:show_root() end }
end

function tz_sound_tool_wnd:build_playlist_entry(path)
    return { label = _get_tail(path), on_select = function() self:show_playlist(path) end }
end

function tz_sound_tool_wnd:build_item_entry(index)
    return { on_select = function() self:play_item_at(index) end }
end

--- Reopen where the window last closed: its view rebuilt from its recipe, then the selected sound and the list's place; root when nothing is kept.
--- @param kept table What hide saved, or an empty table
function tz_sound_tool_wnd:show_view(kept)
    local view = kept.view
    local on_filled = function()
        if kept.index and self.items then self:select_item(kept.index) end
        if kept.place then xcui.set_list_place(self.list, kept.place) end
    end
    if view and view.kind == VIEW_POOL and self:show_pool(view.build, view.back_dir, on_filled) then return end
    if view and view.kind == VIEW_FOLDER then
        self:show_folder(view.dir)
    elseif view and view.kind == VIEW_DRIVES then
        self:show_drives()
    else
        self:show_root()
    end
    on_filled()
end

--- Root: browse the disk, then every dread category when DiegeticDread is present, then every channel with a playable file.
function tz_sound_tool_wnd:show_root()
    local entries = { { label = "[browse files]", on_select = function() self:show_folder(tz_ui.get_logs_dir()) end } }
    for i = 1, #_dread_categories do entries[#entries + 1] = self:build_dread_entry(_dread_categories[i]) end
    for i = 1, #_channel_rows do entries[#entries + 1] = self:build_channel_entry(_channel_rows[i]) end
    self.dir, self.row, self.items, self.index, self.view = nil, nil, nil, nil, { kind = VIEW_ROOT }
    self:set_entries(entries, "root")
    self:render()
end

--- The drive list, shown above a drive root.
function tz_sound_tool_wnd:show_drives()
    self.dir, self.row, self.items, self.index, self.view = "", nil, nil, nil, { kind = VIEW_DRIVES }
    local rows = tz_ui.get_browse_rows("", {})
    local entries = {}
    for i = 1, #rows do entries[i] = self:build_browse_entry(rows[i]) end
    self:set_entries(entries, "drives")
    self:render()
end

--- A folder on disk: "..", then [play this folder] when it holds .ogg files, then subfolders and .txt playlists.
function tz_sound_tool_wnd:show_folder(dir)
    if dir == "" then return self:show_drives() end
    self.dir, self.row, self.items, self.index, self.view = dir, nil, nil, nil, { kind = VIEW_FOLDER, dir = dir }
    local rows, files = tz_ui.get_browse_rows(dir, { EXT_TXT })
    local entries = {}
    for i = 1, #rows do entries[i] = self:build_browse_entry(rows[i]) end
    local oggs = 0
    for i = 1, #files do
        if _get_extension(files[i]) == EXT_OGG then oggs = oggs + 1 end
    end
    if oggs > 0 then
        table_insert(entries, 2, { label = string_format("[play this folder (%d)]", oggs),
            on_select = function() self:show_pool(function() return _build_folder_row(dir) end, dir) end })
    end
    self:set_entries(entries, dir)
    self:render()
end

function tz_sound_tool_wnd:show_playlist(path)
    if not self:show_pool(function() return _load_playlist(path) end, self.dir) then log.warn("[SOUNDTOOL] could not read playlist %s", path) end
end

--- Fill the list with a pool's labels, frame-spread by xslice so xsound.length never builds them all at once; on_filled runs once every row is in.
function tz_sound_tool_wnd:add_pool_rows(items, on_filled)
    local list = self.list
    xslice.start(FILL_QUEUE, items, { step = FILL_STEP, on_done = on_filled, func = function(item)
        list:AddTextItem(self:format_item(item))
        return true
    end })
end

--- A pool of sounds from its recipe: copy its outside files first, then list each with its producer kind and length; ".." returns to back_dir or root.
--- The recipe is kept as the view, so a reopen rebuilds the pool and copies its outside files again.
--- @param build function Returns the row, or nil when there is nothing to list
--- @param back_dir string|nil The folder ".." returns to, else root
--- @param on_filled function|nil Runs once every row is in the list
--- @return boolean False when build returned nothing
function tz_sound_tool_wnd:show_pool(build, back_dir, on_filled)
    local row = build()
    if not row then return false end
    _load_row_sources(row)
    local items = row.items
    self.row, self.items, self.index, self.view = row, items, nil, { kind = VIEW_POOL, build = build, back_dir = back_dir }
    local entries = { { label = "..", on_select = function()
        if back_dir then self:show_folder(back_dir) else self:show_root() end
    end } }
    for i = 1, #items do entries[#entries + 1] = self:build_item_entry(i) end
    self:set_entries(entries, string_format("%s    (%d)", row.name, #items))
    self:add_pool_rows(items, on_filled)
    self:render()
    return true
end

function tz_sound_tool_wnd:format_item(item)
    if item.is_divider or not item.producer then return item.label end
    if not item.path then return item.label .. "  [not copied]" end
    local seconds = xsound.length(item.path) / 1000
    return string_format("%s  [%s]  %.1fs", item.label, item.producer.kind, seconds)
end

--- Load the pool item at index without playing it; dividers and unclaimed lines only select.
function tz_sound_tool_wnd:select_item(index)
    self.index = index
    self.last_play = nil
    self:render()
end

function tz_sound_tool_wnd:play_item_at(index)
    self:select_item(index)
    self:play_current()
end

--- Step to the previous or next playable item without playing it.
function tz_sound_tool_wnd:select_neighbor(delta)
    local items = self.items
    if not (items and #items > 0) then return end
    local count = #items
    local index = self.index or (delta < 0 and count + 1 or 0)
    for _ = 1, count do
        index = (index - 1 + delta) % count + 1
        if _is_playable(items[index]) then break end
    end
    self.list:SetSelectedIndex(index)
    self:select_item(index)
end

function tz_sound_tool_wnd:get_current()
    return self.items and self.index and self.items[self.index]
end

--- A click on a mode key lights it. It never plays.
function tz_sound_tool_wnd:select_mode_group(group)
    self.mode_group = group
    self:render()
end

--- A preset key: the distance goes into the box, 3D lights, and the sound plays there.
function tz_sound_tool_wnd:play_at_dist(dist)
    self.box_dist:SetText(tostring(dist))
    self.mode_group = GROUP_3D
    self:play_current()
end

--- The volume keys: step the playback volume down (-1) or up (+1), between GAIN_MIN and GAIN_MAX. It never plays.
function tz_sound_tool_wnd:select_gain(delta)
    local gain = math_floor((self.gain + delta * GAIN_STEP) * 10 + 0.5) / 10
    if gain < GAIN_MIN then gain = GAIN_MIN elseif gain > GAIN_MAX then gain = GAIN_MAX end
    self.gain = gain
    self:render()
end

--- The 3D settings from the boxes: the distance, kept when the box holds no positive number, and the height.
--- The falloff bounds come back only when both boxes hold a min of 0 or more and a larger max, else nil for the file's own.
function tz_sound_tool_wnd:read_settings()
    local dist = _read_box(self.box_dist)
    if dist and dist > 0 then self.dist = dist else self.box_dist:SetText(tostring(self.dist)) end
    local min_dist, max_dist = _read_box(self.box_min_dist), _read_box(self.box_max_dist)
    local height = _read_box(self.box_height) or 0
    if not (min_dist and max_dist and min_dist >= 0 and max_dist > min_dist) then return height, nil, nil end
    return height, min_dist, max_dist
end

--- A 3D play camera-forward at the kept distance, with the box height and the falloff from the boxes when both are filled.
function tz_sound_tool_wnd:play_front(item)
    local height, min_dist, max_dist = self:read_settings()
    local pos = _compute_front_pos(self.dist, height)
    local handle = pos and _run_own_play(xsound.play_at, item.path,
        { position = pos, volume = self.gain, min_distance = min_dist, max_distance = max_dist })
    local falloff = min_dist and string_format(" | falloff %g-%g m", min_dist, max_dist) or ""
    return handle, { dist = math_sqrt(self.dist * self.dist + height * height), volume = self.gain,
        text = string_format("3D | %g m | h%g | vol %.2f%s", self.dist, height, self.gain, falloff) }
end

--- Start one play of the current item in the lit mode and keep its handle and what it rolled.
function tz_sound_tool_wnd:play_current()
    local item = self:get_current()
    if not (_is_playable(item) and db.actor) then return end
    local group = _select_group(item, self.mode_group)
    local handle, roll
    if group == GROUP_GAME then
        handle, roll = _play_game(item, self.gain)
    elseif group == GROUP_2D then
        handle = _run_own_play(xsound.play_at, item.path, { s2d = true, volume = self.gain })
        roll = { volume = self.gain, text = string_format("2D | vol %.2f", self.gain) }
    else
        handle, roll = self:play_front(item)
    end
    self.last_play = roll
    log.debug("[SOUNDTOOL] play %s producer=%s %s handle=%s", item.source or item.path, item.producer.kind, roll.text, tostring(handle))
    if handle then _handles[#_handles + 1] = handle end
    self:render()
    self:start_lamp_watch()
end

--- Re-arm a short timer that refreshes the lamps until no play the tool started still sounds or the window closes.
function tz_sound_tool_wnd:start_lamp_watch()
    CreateTimeEvent(LAMP_EV, "lamps", LAMP_PERIOD, function()
        if not self:IsShown() then return true end
        self:render_lamps()
        if not _is_playing() then return true end
        ResetTimeEvent(LAMP_EV, "lamps", LAMP_PERIOD)
        return false
    end)
end

function tz_sound_tool_wnd:stop_current()
    _stop_plays()
    self:render_lamps()
end

--- Write good, bad or note for the current item with the last play it had and the typed note; note needs typed text. It never plays or advances.
function tz_sound_tool_wnd:add_verdict(verdict)
    local item = self:get_current()
    local typed = self.note:GetText()
    if not _is_playable(item) or (verdict == VERDICT_NOTE and typed == "") then return end
    local play_text = self.last_play and self.last_play.text or "not played"
    local is_written = _write_verdict(self.row and self.row.name or "", item, verdict, play_text, typed)
    self.note:SetText("")
    local feed_text = typed ~= "" and (verdict == VERDICT_NOTE and typed or verdict .. ": " .. typed) or verdict
    if is_written then _add_feed_line(item, feed_text) else log.warn("[SOUNDTOOL] could not write %s", tz_ui.get_session_path(OUTPUT_TOOL)) end
    self:render()
end

--- Build the channel rows, the dread categories and the theme and thunder indexes.
function tz_sound_tool_wnd:build_indexes()
    _build_channel_rows()
    _build_dread_index()
    _build_producer_index()
end

--- Re-read every index, then the open folder or the root; an open pool stays as loaded.
function tz_sound_tool_wnd:update_indexes()
    self:build_indexes()
    if self.row then return self:render() end
    if self.dir then return self:show_folder(self.dir) end
    self:show_root()
end

--- Green while a play the tool started still sounds, red once none does; the unlit lamp is faded.
function tz_sound_tool_wnd:render_lamps()
    tz_ui.render_lamps(self.ui, _is_playing())
end

--- Light the mode the current item plays in, its outline on and its label bright; game is off for an item its producer cannot replay.
function tz_sound_tool_wnd:render_keys(item)
    local group = item and _select_group(item, self.mode_group) or self.mode_group
    for _, key in ipairs(GROUP_ORDER) do
        local is_on = key == group
        self.mode_lits[key]:Show(is_on)
        local rgb = is_on and LABEL_LIT_RGB or LABEL_RGB
        self.mode_keys[key]:TextControl():SetTextColor(xcui.get_color(rgb[1], rgb[2], rgb[3], 255))
    end
    self.mode_keys[GROUP_GAME]:Enable(item == nil or _can_play_game(item))
end

--- The loudness row: the game copy's measure and estimate, or an outside file's playlist comment, then the file's own falloff.
function tz_sound_tool_wnd:format_loud(item)
    local blob = _get_item_blob(item)
    local falloff = blob and string_format(" | blob %g-%g m bv %.2f", blob.mn, blob.mx, blob.bv) or ""
    if item.source then return xcui.get_clipped((item.comment or "outside file, not measured") .. falloff, LOUD_CHARS) end
    local profile = xsound.get_meta(item.key)
    if not (profile and profile.lufs) then return "game copy, no measure" .. falloff end
    local play = self.last_play or { dist = self.dist, volume = self.gain }
    local delivered = xsound.compute_delivered_loudness(profile, play.dist, play.volume)
    return string_format("game copy %.1f LUFS | est %.0f dB%s", profile.lufs, delivered or -120, falloff)
end

function tz_sound_tool_wnd:render()
    xcui.set_lines(self.feed_rows, _feed)
    self:render_lamps()
    local item = self:get_current()
    local playable = _is_playable(item) and item or nil
    self:render_keys(playable)
    if not playable then
        self.lbl_now:SetText("now:    (none - click a sound)")
        self.lbl_place:SetText("")
        self.lbl_loud:SetText("")
        self.sel_line:SetText("")
        return
    end
    local producer = item.producer
    self.lbl_now:SetText(xcui.get_clipped(string_format("%s  ::  %s", producer.label, item.label), LOUD_CHARS))
    local place = self.last_play and self.last_play.text or producer.reason or ""
    self.lbl_place:SetText(string_format("%s  |  gain %.1f", place, self.gain))
    self.lbl_loud:SetText(self:format_loud(item))
    self.sel_line:SetText(string_format("%s   %s", item.label, producer.where))
end

function tz_sound_tool_wnd:show_help()
    tz_help.show_page("tz_sound_tool.xml", "st_tz_sound_tool_help_title", "st_tz_sound_tool_help")
end

--- Esc closes the window when no edit box has focus, so typing a note or a number never closes it.
function tz_sound_tool_wnd:OnKeyboard(dik, action)
    local res = CUIScriptWnd.OnKeyboard(self, dik, action)
    if not xcui.is_close_key(res, dik, action) then return res end
    self:hide()
    return true
end

--- Close: keep where it stood, stop the tool's own plays, empty the cache, lift the dread silence; the mute stays as it is.
function tz_sound_tool_wnd:hide()
    self:read_settings()
    _kept = { view = self.view, index = self.index, mode_group = self.mode_group, gain = self.gain, dist = self.dist,
        height = _read_box(self.box_height), min_dist = _read_box(self.box_min_dist),
        max_dist = _read_box(self.box_max_dist), place = xcui.get_list_place(self.list) }
    xslice.stop_queue(FILL_QUEUE, true)
    RemoveTimeEvent(LAMP_EV, "lamps")
    _stop_plays()
    log.info("[SOUNDTOOL] close: cleared %d cached files", _clear_cache())
    if _is_dread_available() then dd_director.set_muted(false) end
    self:HideDialog()
    Unregister_UI("tz_sound_tool_wnd")
end

--- axr_main loads every script before any on_game_start (anomaly/axr_main.script:648-663), so the seam relays exist and the saved mute attaches here.
function on_game_start()
    RegisterScriptCallback("on_key_press", _on_key_press)
    RegisterScriptCallback("actor_on_net_destroy", _on_actor_destroy)
    RegisterScriptCallback("on_option_change", _apply_mute_option)
    _apply_mute_option()
end
